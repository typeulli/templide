-- access_tool/_clean.tlide --
#include <std/stddef>
master deck {
    case content {
        put placeholder { role = title; x = 60px; y = 30px; width = 1160px; height = 80px; }
    }
}
slide {
    layout = deck.content;
    title = "접근성 검사를 통과하는 슬라이드";
    put text_box { text = "본문"; x = 60px; y = 130px; width = 600px; height = 40px; }
    put image { data = file("x.png"); alt = "로고"; x = 60px; y = 200px; width = 100px; height = 100px; }
    put image { data = file("x.png"); alt = ""; x = 200px; y = 200px; width = 100px; height = 100px; }
    put table { cells = [["이름", "값"], ["a", "1"]]; header_rows = 1; x = 60px; y = 320px; width = 400px; height = 100px; }
}
target out { path = "out.pptx"; type = pptx; }
-- access_tool/_chart.tlide --
#include <std/stddef>
master deck {
    case content {
        put placeholder { role = title; x = 60px; y = 30px; width = 1160px; height = 80px; }
    }
}
slide {
    layout = deck.content;
    title = "차트의 대체 텍스트";
    put chart { kind = column; values = [[1, 2]]; x = 0; y = 0; width = 400; height = 300; }
    put chart { kind = line; values = [[1, 2]]; x = 400; y = 0; width = 400; height = 300; alt = "꺾은선 차트"; }
}
-- access_tool/_broken.tlide --
#include <std/stddef>
slide { put image { data = file("x.png"); alta = "로고"; x = 0; y = 0; width = 10; height = 10; } }
-- access_tool/x.png (base64) --
iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6
kgAAAABJRU5ErkJggg==
-- access_tool/main.steps --
# 접근성 검사. 결과는 원문 순서로 나오고, 오류가 있으면 종료 코드 1이다
tool access main.tlide
tool access main.tlide --format json
tool access main.tlide --format github
# 이미지, 비디오, 오디오와 차트는 alt가 있어야 한다
tool access _chart.tlide
# 문제가 없는 문서
tool access _clean.tlide
tool access _clean.tlide --strict
# --check에는 --access를 붙여야 합쳐진다
main.tlide --check
main.tlide --check --access
_clean.tlide --check --access --strict
# 문서에 오류가 있으면 그것만 알린다. 사용법 오류는 2다
tool access _broken.tlide
tool access
tool access nothing_here.tlide
-- math_web/main.tlide --
/* 수식이 있으면 web 출력에 KaTeX(katex/)가 함께 들어가고, 없으면 들어가지 않는다 */
#include <std/stddef>
slide {
    put math { latex = "E = mc^2"; x = 0px; y = 0px; width = 400px; height = 100px; }
}
target site { path = "site"; type = web; }
