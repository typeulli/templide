fmt main.tlide
fmt main.tlide
fmt --check main.tlide
main.tlide --check --fmt --strict
# #fmt가 없는 파일은 건너뛴다
fmt _plain.tlide
fmt --check _plain.tlide
# 사용법 오류와 파일 오류
fmt
fmt nothing_here.tlide
fmt --stdout --check main.tlide
fmt --stdout main.tlide _plain.tlide
-- access_tool/main.tlide --
#include <std/stddef>
#include <std/styles>
master deck {
    case content {
        put placeholder { role = title; x = 60px; y = 30px; width = 1160px; height = 80px; }
    }
}
slide {
    layout = deck.content;
    title = "접근성 예제";
    background = hex(FFFFFF);
    put image { data = file("x.png"); x = 0; y = 400; width = 100; height = 100; }
    put image { data = file("x.png"); x = 100; y = 400; width = 100; height = 100; alt = ""; }
    put image { data = file("x.png"); x = 200; y = 400; width = 100; height = 100; alt = "로고"; }
    put text_box { text = (style(color = hex(CCCCCC)) "light gray text"); x = 0; y = 300; width = 400; height = 40; }
    put text_box { text = (style(font-size = 10pt) "tiny"); x = 0; y = 340; width = 400; height = 40; }
    put text_box { text = "아래 글을 먼저 읽는다"; x = 0; y = 500px; width = 400; height = 40; }
    put text_box { text = "위에 있는 글"; x = 0; y = 100px; width = 400; height = 40; }
    put shape { kind = rect; x = 500; y = 400; width = 50; height = 50; }
    put table { cells = [["a", "b"], ["c", "d"]]; x = 0; y = 600; width = 300; height = 100; }
    put table { cells = [["a", "b"]]; header_rows = 1; x = 400; y = 600; width = 300; height = 50; }
}
slide {
    put text_box { text = (style(color = hex(777777)) "gray on gray"); fill = hex(888888); x = 0; y = 0; width = 100; height = 40; }
}
