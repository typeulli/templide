-- ast_dump.tlide --
/* --ast는 구문 트리를 찍는다 (분석 전이라 의미 오류가 있어도 찍힌다). 연산 우선순위, 목록, f-string, 단위, 색, 블록 문장을 한 번에 본다 */
#include <std/stddef>
enum mode { fast, slow }
style bold { font-weight = bold; }
style big(int n) { font-size = n * 2pt; }
color red rgb(255, 0, 0);

object card {
    var text title;
    var mode mode = fast;
}

template row {
    var int n;
    for (int i in 1..n) {
        put card { title = f"행 {i + 1 * 2}"; }
    }
    if (n == 3) { put card { title = "셋"; } } else if (n == 4) { put card { title = "넷"; } } else { put card { title = "그 밖"; } }
}

master deck {
    theme = nothing;
    case a { background = linear(90, hex(F00), rgba(0, 0, 255, 0.5)); }
}

slide {
    layout = deck.a;
    put card as c { title = bold big(3) "굵게" bullets ["하나", numbers ["안쪽"]] style(color = hsl(30deg, 100%, 50%)) "색"; }
    group as g { put row { n = 1 + 2 * 3 - 4; } }
    comment "메모";
    transition fade.through_black 1s;
    animate c enter fly.left 1s with_previous delay 0.5s;
    review { text = "검토"; }
}

section "구역";
image logo = file("logo.png");
asset "pics.tasset" by { * as p, "a.png" as q } default;
target out { path = "a.pptx"; type = pptx; }
-- ast_dump.expected --
$ templide ast_dump.tlide --ast
[exit] 0
[stdout]
File ast_dump.tlide
  Include <std/stddef>
  Enum mode { fast, slow }
  Style bold
    StyleAssign font-weight
      Name bold
  Style big(int n)
    StyleAssign font-size
      Multiply
        Name n
        Dimension 2pt
  Style red
    StyleAssign color
      ColorRGB
        Int 255
        Int 0
        Int 0
  Object card
    Var text title
    Var mode mode
      Name fast
  Template row
    Var int n
    For int i
      range:
        Int 1
        Name n
      body:
        Put card
          Assign title
            FString
              String "행 "
              Add
                Name i
                Multiply
                  Int 1
                  Int 2
    If
      condition:
        Equal
          Name n
          Int 3
      body:
        Put card
          Assign title
            String "셋"
      branch:
        ElseIf
          condition:
            Equal
              Name n
              Int 4
          body:
            Put card
              Assign title
                String "넷"
          branch:
            Else
              Put card
                Assign title
                  String "그 밖"
  Master deck
    Assign theme
      Name nothing
    Case a
      Assign background
        Call linear
          Int 90
          ColorHex F00
          ColorRGBA
            Int 0
            Int 0
            Int 255
            Float 0.5
  Slide
    Assign layout
      Member .a
        Name deck
    Put card as c
      Assign title
        Text
          Name bold
          Call big
            Int 3
          String "굵게"
          List bullets
            String "하나"
            List numbers
              String "안쪽"
          InlineStyle
            StyleAssign color
              Color hsl
                Dimension 30deg
                Dimension 100%
                Dimension 50%
          String "색"
    Group as g
      Put row
        Assign n
          Minus
            Add
              Int 1
              Multiply
                Int 2
                Int 3
            Int 4
    Comment
      String "메모"
    Transition fade.through_black
      Dimension 1s
    Animate c enter fly.left with_previous
      duration:
        Dimension 1s
      delay:
        Dimension 0.5s
    Review
      Assign text
        String "검토"
  Section
    String "구역"
  Constant image logo
    Call file
      String "logo.png"
  Asset "pics.tasset" default by
    * as p
    "a.png" as q
  Target out
    Assign path
      String "a.pptx"
    Assign type
      Name pptx
-- ast_dump.steps --
ast_dump.tlide --ast
-- build_web.tlide --
/* type = web은 path 폴더에 index.html과 reveal.js, templide.js, 라이선스를 쓴다. 폴더가 없으면 만든다 */
#include <std/stddef>

slide {
    put text_box { text = "web 폴더"; x = 10px; y = 10px; width = 300px; height = 30px; }
}

target site { path = "out/site"; type = web; }
