-- diagnostic_formats/main.steps --
# 경고만 있으면 성공하고, --strict면 실패한다
main.tlide --check
main.tlide --check --strict
main.tlide --check --format json
main.tlide --check --format github
main.tlide --check --format json --strict
# 오류와 고치는 방법. 진단 메시지는 영어뿐이다. text, JSON, GitHub 형식
_broken.tlide --check
_broken.tlide --check --format json
_broken.tlide --check --format=github
# 사용법 오류는 종료 코드 2다
_broken.tlide --check --format xml
_broken.tlide --check --format
_broken.tlide --check --lang en
_broken.tlide --check --no-such-option
-- fmt_command/main.tlide --
/* tlide fmt: 파일을 고치고(fmt), 고치지 않고 알리고(--check), 컴파일러의 --check에 합칠 수(--fmt) 있다 */
#fmt indent_size 2
#include <std/stddef>
slide {
put text_box { text = "a"; x = 10px; y = 10px; width = 100px; height = 30px; }
    put text_box { text = "b"; x = 10px; y = 50px; width = 100px; height = 30px; }
}
target out { path = "out.pptx"; type = pptx; }
