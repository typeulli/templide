-- table_cells_format.tlide --
/* 칸의 글과 서식. 글이 문자열 하나뿐인 칸은 그 리터럴만 바꾸고(감싼 style이 남는다), cell 블록이 없으면 만들고, 마지막 속성을 지우면 블록도 지운다 */
#include <std/stddef>

slide {
    put table {
        x = 80px; y = 120px; width = 1120px; height = 300px;
        cells = [
            ["이름", "1분기"],
            ["서울", (style(font-weight = bold) "20")]
        ];
    }
}

target out { path = "out.pptx"; type = pptx; }
-- table_cells_format.expected --
