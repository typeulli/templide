-        x = 100; y = 100; width = w; height = 120;
+        x = 120; y = 110; width = w; height = 120;

$ {"definition": {"kind": "template", "name": "card"}, "op": "set", "id": "@shape", "name": "height", "length": 90}
[diff]
-        x = 120; y = 110; width = w; height = 120;
+        x = 120; y = 110; width = w; height = 90;

