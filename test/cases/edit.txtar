[error] This value comes from a template parameter; change its default value in the parameter list

$ {"definition": {"kind": "template", "name": "card"}, "op": "var_default", "name": "w", "length": 420}
[diff]
-    var int w = 300;
+    var int w = 420;

$ {"definition": {"kind": "template", "name": "card"}, "op": "var_default", "name": "tone", "color": "#3498DB"}
[diff]
-    var color tone;
+    var color tone = hex(3498DB);

$ {"definition": {"kind": "template", "name": "card"}, "op": "var_default_clear", "name": "w"}
[diff]
-    var int w = 420;
+    var int w;

$ {"definition": {"kind": "template", "name": "card"}, "op": "var_add", "type": "int", "name": "count", "default": "0"}
[diff]
