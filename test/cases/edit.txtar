-- slide_move.tlide --
/* 썸네일을 끌어 slide를 옮긴다. slide 바로 위(빈 줄 없이)에 자기 줄을 차지한 주석은 함께 가고, 빈 줄로 떨어진 주석과 정의는 제자리에 있다 */
#include <std/stddef>

/* 정의 위 설명 */
object tag { var text text; }

/* 첫째 설명 */
slide { put tag { text = "1"; } }

/* 둘째 설명 1 */
/* 둘째 설명 2 */
slide { put tag { text = "2"; } }

/* 셋째와 떨어진 주석 */

slide { put tag { text = "3"; } }
-- slide_move.expected --
$ {"op": "slide", "action": "move", "page": 3, "to": 1}
[diff]
+slide { put tag { text = "3"; } }
-slide { put tag { text = "3"; } }

$ {"op": "slide", "action": "move", "page": 1, "to": 3}
[diff]
-slide { put tag { text = "3"; } }
+slide { put tag { text = "3"; } }

$ {"op": "slide", "action": "up", "page": 2}
[diff]
+/* 둘째 설명 1 */
+/* 둘째 설명 2 */
+slide { put tag { text = "2"; } }
-/* 둘째 설명 1 */
-/* 둘째 설명 2 */
-slide { put tag { text = "2"; } }

$ {"op": "slide", "action": "down", "page": 1}
[diff]
+/* 첫째 설명 */
+slide { put tag { text = "1"; } }
-/* 첫째 설명 */
-slide { put tag { text = "1"; } }

$ {"op": "slide", "action": "move", "page": 2, "to": 2}
[diff]
(바뀐 것 없음)

$ {"op": "slide", "action": "move", "page": 1, "to": 9}
[error] No slide 9
-- slide_move.edits --
{"op": "slide", "action": "move", "page": 3, "to": 1}
{"op": "slide", "action": "move", "page": 1, "to": 3}
{"op": "slide", "action": "up", "page": 2}
{"op": "slide", "action": "down", "page": 1}
{"op": "slide", "action": "move", "page": 2, "to": 2}
{"op": "slide", "action": "move", "page": 1, "to": 9}
