-- table_cells_format.tlide --
/* 칸의 글과 서식. 글이 문자열 하나뿐인 칸은 그 리터럴만 바꾸고(감싼 style이 남는다), cell 블록이 없으면 만들고, 마지막 속성을 지우면 블록도 지운다 */
#include <std/stddef>

slide {
    put table {
        x = 80px; y = 120px; width = 1120px; height = 300px;
        cells = [
            ["이름", "1분기"],
            ["서울", (style(font-weight = bold) "20")]
        ];
    }
}

target out { path = "out.pptx"; type = pptx; }
-- table_cells_format.expected --
$ {"op": "table", "id": "@table", "action": "text", "row": 0, "column": 0, "text": "열 \"A\"\n둘째 줄"}
[diff]
-            ["이름", "1분기"],
+            ["열 \"A\"\n둘째 줄", "1분기"],

$ {"op": "table", "id": "@table", "action": "text", "row": 1, "column": 1, "text": "30"}
[diff]
-            ["서울", (style(font-weight = bold) "20")]
+            ["서울", (style(font-weight = bold) "30")]

$ {"op": "table", "id": "@table", "action": "cell_set", "row": 1, "column": 0, "name": "fill", "color": "#FFE699"}
[diff]
+        cell(2, 1) { fill = hex(FFE699); }

$ {"op": "table", "id": "@table", "action": "cell_set", "row": 1, "column": 0, "name": "align", "enum": "center"}
[diff]
-        cell(2, 1) { fill = hex(FFE699); }
+        cell(2, 1) { fill = hex(FFE699); align = center; }

$ {"op": "table", "id": "@table", "action": "cell_set", "row": 1, "column": 0, "name": "line_width_bottom", "length": 3}
[diff]
-        cell(2, 1) { fill = hex(FFE699); align = center; }
+        cell(2, 1) { fill = hex(FFE699); align = center; line_width_bottom = 3px; }

$ {"op": "table", "id": "@table", "action": "cell_unset", "row": 1, "column": 0, "name": "fill"}
[diff]
-        cell(2, 1) { fill = hex(FFE699); align = center; line_width_bottom = 3px; }
+        cell(2, 1) { align = center; line_width_bottom = 3px; }

$ {"op": "table", "id": "@table", "action": "cell_unset", "row": 1, "column": 0, "name": "align"}
[diff]
-        cell(2, 1) { align = center; line_width_bottom = 3px; }
+        cell(2, 1) { line_width_bottom = 3px; }

$ {"op": "table", "id": "@table", "action": "cell_unset", "row": 1, "column": 0, "name": "line_width_bottom"}
[diff]
-        cell(2, 1) { line_width_bottom = 3px; }

$ {"op": "table", "id": "@table", "action": "sizes", "axis": "columns", "values": [300, 820]}
[diff]
+        col_widths = [300px, 820px];

$ {"op": "table", "id": "@table", "action": "sizes", "axis": "rows", "values": [100, 200]}
[diff]
+        row_heights = [100px, 200px];

$ {"op": "table", "id": "@table", "action": "sizes", "axis": "columns", "values": [300]}
[error] The number of sizes does not match the table
