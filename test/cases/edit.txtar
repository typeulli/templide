-- definition_template.tlide --
/* template 편집 화면. 안의 요소는 slide에 적은 것처럼 고칠 수 있고, 매개변수에서 온 값만 잠긴다. 기본값을 고치고 지우고 매개변수를 더하고 뺀다 */
#include <std/stddef>

template card {
    var text title;
    var int w = 300;
    var color tone;
    put shape {
        kind = roundRect;
        x = 100; y = 100; width = w; height = 120;
        fill = tone;
    }
    put text_box { text = title; x = 110; y = 110; width = 280; height = 40; }
}

slide {
    put card { title = "A"; w = 240; tone = hex(F00); }
}

target out { path = "out.html"; type = html; }
-- definition_template.expected --
$ {"definition": {"kind": "template", "name": "card"}, "op": "move", "id": "@shape", "dx": 20, "dy": 10}
