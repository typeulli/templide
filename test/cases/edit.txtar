-- table_structure.edits --
# 줄: 가운데에 끼우면 뒤의 cell 번호가 하나 밀리고, 머리글(첫 줄) 앞에 끼우면 머리글이 하나 늘어난다
{"op": "table", "id": "@table", "action": "insert_row", "index": 1}
{"op": "table", "id": "@table", "action": "insert_row", "index": 0}
{"op": "table", "id": "@table", "action": "insert_row", "index": 5}
{"op": "table", "id": "@table", "action": "remove_row", "index": 0}
{"op": "table", "id": "@table", "action": "remove_row", "index": 4}
# 칸: col_widths에도 한 항목이 끼고, 병합한 칸 한가운데에 끼우면 병합이 늘어난다
{"op": "table", "id": "@table", "action": "insert_column", "index": 1}
{"op": "table", "id": "@table", "action": "insert_column", "index": 3}
{"op": "table", "id": "@table", "action": "remove_column", "index": 0}
{"op": "table", "id": "@table", "action": "remove_column", "index": 3}
# 없는 자리와 마지막 하나는 거절된다
{"op": "table", "id": "@table", "action": "remove_row", "index": 99}
