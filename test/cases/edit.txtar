+            ["열 \"A\"\n둘째 줄", "1분기"],

$ {"op": "table", "id": "@table", "action": "text", "row": 1, "column": 1, "text": "30"}
[diff]
-            ["서울", (style(font-weight = bold) "20")]
+            ["서울", (style(font-weight = bold) "30")]

$ {"op": "table", "id": "@table", "action": "cell_set", "row": 1, "column": 0, "name": "fill", "color": "#FFE699"}
[diff]
+        cell(2, 1) { fill = hex(FFE699); }

$ {"op": "table", "id": "@table", "action": "cell_set", "row": 1, "column": 0, "name": "align", "enum": "center"}
[diff]
-        cell(2, 1) { fill = hex(FFE699); }
+        cell(2, 1) { fill = hex(FFE699); align = center; }

$ {"op": "table", "id": "@table", "action": "cell_set", "row": 1, "column": 0, "name": "line_width_bottom", "length": 3}
[diff]
