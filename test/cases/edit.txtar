-- table_locked.tlide --
/* template 안에서 정한 표와 cells를 계산한 표는 줄과 칸을 고칠 수 없다. 편집기는 이유를 보여 준다 */
#include <std/stddef>

template fixed {
    put table { x = 0; y = 0; width = 200; height = 100; cells = [["a", "b"], ["c", "d"]]; }
}

slide {
    put fixed { }
}

target out { path = "out.pptx"; type = pptx; }
-- table_locked.expected --
$ {"op": "table", "id": "@table", "action": "insert_row", "index": 1}
[error] This value is written inside a template definition; change it in the code

$ {"op": "table", "id": "@table", "action": "text", "row": 0, "column": 0, "text": "x"}
[error] This value is written inside a template definition; change it in the code

$ {"op": "table", "id": "@table", "action": "cell_set", "row": 0, "column": 0, "name": "fill", "color": "#FF0000"}
[error] This value is written inside a template definition; change it in the code

$ {"op": "table", "id": "@table", "action": "merge", "row": 0, "column": 0, "rows": 1, "columns": 2}
[error] This value is written inside a template definition; change it in the code
-- table_locked.edits --
{"op": "table", "id": "@table", "action": "insert_row", "index": 1}
{"op": "table", "id": "@table", "action": "text", "row": 0, "column": 0, "text": "x"}
{"op": "table", "id": "@table", "action": "cell_set", "row": 0, "column": 0, "name": "fill", "color": "#FF0000"}
{"op": "table", "id": "@table", "action": "merge", "row": 0, "column": 0, "rows": 1, "columns": 2}
-- table_merge.tlide --
/* 병합하면 가려지는 칸의 글을 비우고 왼쪽 위 칸에 span을 적는다. 겹치면 거절하고, 풀면 span과 (비게 된) cell 블록을 지운다 */
#include <std/stddef>

slide {
    put table {
        x = 80px; y = 120px; width = 1120px; height = 300px;
        cells = [
            ["a", "b", "c"],
            ["d", "e", "f"],
            ["g", "h", "i"]
        ];
        cell(2, 2) { fill = hex(EEE); }
    }
}

target out { path = "out.pptx"; type = pptx; }
-- table_merge.expected --
$ {"op": "table", "id": "@table", "action": "merge", "row": 0, "column": 0, "rows": 1, "columns": 2}
[diff]
-            ["a", "b", "c"],
+            ["a", "", "c"],
+        cell(1, 1) { col_span = 2; }

$ {"op": "table", "id": "@table", "action": "merge", "row": 1, "column": 1, "rows": 2, "columns": 2}
[diff]
-            ["d", "e", "f"],
-            ["g", "h", "i"]
+            ["d", "e", ""],
+            ["g", "", ""]
-        cell(2, 2) { fill = hex(EEE); }
+        cell(2, 2) { fill = hex(EEE); row_span = 2; col_span = 2; }

$ {"op": "table", "id": "@table", "action": "merge", "row": 0, "column": 1, "rows": 2, "columns": 1}
[error] The selection overlaps a merged cell; split it first

$ {"op": "table", "id": "@table", "action": "merge", "row": 2, "column": 2, "rows": 2, "columns": 1}
[error] The selection reaches outside the table

$ {"op": "table", "id": "@table", "action": "split", "row": 1, "column": 1}
[diff]
-        cell(2, 2) { fill = hex(EEE); row_span = 2; col_span = 2; }
+        cell(2, 2) { fill = hex(EEE); }

$ {"op": "table", "id": "@table", "action": "split", "row": 0, "column": 0}
[diff]
-        cell(1, 1) { col_span = 2; }

$ {"op": "table", "id": "@table", "action": "split", "row": 0, "column": 0}
[error] This cell is not merged
-- table_merge.edits --
{"op": "table", "id": "@table", "action": "merge", "row": 0, "column": 0, "rows": 1, "columns": 2}
{"op": "table", "id": "@table", "action": "merge", "row": 1, "column": 1, "rows": 2, "columns": 2}
{"op": "table", "id": "@table", "action": "merge", "row": 0, "column": 1, "rows": 2, "columns": 1}
{"op": "table", "id": "@table", "action": "merge", "row": 2, "column": 2, "rows": 2, "columns": 1}
{"op": "table", "id": "@table", "action": "split", "row": 1, "column": 1}
{"op": "table", "id": "@table", "action": "split", "row": 0, "column": 0}
{"op": "table", "id": "@table", "action": "split", "row": 0, "column": 0}
-- table_structure.tlide --
/* 표의 줄과 칸을 끼우고 빼면 cells, col_widths, row_heights, header_rows, 그리고 cell(행, 열)의 번호와 병합 크기가 함께 바뀐다 */
#include <std/stddef>
#include <std/styles>

slide {
    put table {
        x = 80px; y = 120px; width = 1120px; height = 300px;
        cells = [
            ["이름", "1분기", "2분기"],
            ["서울", "10", bold "20"],
            ["합계", "", ""]
        ];
        col_widths = [400px, 360px, 360px];
        header_rows = 1;
        cell(3, 2) {
            col_span = 2;
            fill = hex(EEE);
        }
    }
}

target out { path = "out.pptx"; type = pptx; }
