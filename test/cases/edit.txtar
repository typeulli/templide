-- definition_template.edits --
# 요소를 옮기고 크기를 바꾼다 (template 안의 값이라도 리터럴이면 바로 고친다)
{"definition": {"kind": "template", "name": "card"}, "op": "move", "id": "@shape", "dx": 20, "dy": 10}
{"definition": {"kind": "template", "name": "card"}, "op": "set", "id": "@shape", "name": "height", "length": 90}
# 매개변수에서 온 값은 잠겨 있다
{"definition": {"kind": "template", "name": "card"}, "op": "set", "id": "@shape", "name": "width", "length": 200}
# 기본값 고치기, 새로 넣기, 지우기
{"definition": {"kind": "template", "name": "card"}, "op": "var_default", "name": "w", "length": 420}
{"definition": {"kind": "template", "name": "card"}, "op": "var_default", "name": "tone", "color": "#3498DB"}
{"definition": {"kind": "template", "name": "card"}, "op": "var_default_clear", "name": "w"}
# 매개변수 더하기 (기본값과 함께 넣어 이미 쓰는 put이 깨지지 않는다)
{"definition": {"kind": "template", "name": "card"}, "op": "var_add", "type": "int", "name": "count", "default": "0"}
# 새 요소를 template 블록 끝에 넣는다
{"definition": {"kind": "template", "name": "card"}, "op": "insert", "page": 1, "object": "text_box", "properties": [{"name": "text", "string": "New"}, {"name": "x", "length": 5}, {"name": "y", "length": 5}, {"name": "width", "length": 100}, {"name": "height", "length": 40}]}
-- definition_master.tlide --
/* master case 편집 화면. case의 배경과 요소를 slide처럼 고친다 */
#include <std/stddef>

master brand {
    var color ink = hex(222);
    case title {
        background = hex(FFF8E0);
        put text_box { text = "Title"; x = 80; y = 60; width = 600; height = 80; }
    }
    case body {
        put shape { kind = rect; x = 0; y = 0; width = 1280; height = 12; }
    }
}

slide {
    layout = brand(hex(222)).title;
}

target out { path = "out.html"; type = html; }
