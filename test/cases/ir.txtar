-- stddef_objects.tlide --
/* std/stddef의 개체들: text_box, shape, line, connector, freeform, backdrop. 채우기와 선, 그림자 같은 공통 속성도 함께 쓴다 */
#include <std/stddef>

slide {
    background = linear(90, hex(FFF), hex(DDD));
    put text_box { text = "글상자"; x = 40px; y = 30px; width = 400px; height = 60px; anchor = middle; }
    put shape as left {
        kind = roundRect;
        x = 40px; y = 120px; width = 160px; height = 100px;
        radius = 12px;
        fill = hex(3498DB);
        line_color = hex(2C3E50);
        line_width = 2px;
        line_dash = dash;
        text = "도형";
    }
    put shape as right {
        kind = star5;
        x = 300px; y = 120px; width = 100px; height = 100px;
        fill = radial(hex(F1C40F), hex(E67E22));
        shadow = rgba(0, 0, 0, 0.4);
        shadow_blur = 6px;
        shadow_distance = 4px;
        shadow_angle = 45;
        rotation = 15;
    }
    put shape { kind = rect; x = 40px; y = 260px; width = 100px; height = 60px; fill = pattern(diagonal_cross, hex(000), hex(FFF)); flip = horizontal; }
    put shape { kind = triangle; x = 160px; y = 260px; width = 100px; height = 60px; fill = hex(E74C3C) ; opacity = 0.5; adj1 = 0.3; }
    put line { x1 = 40px; y1 = 350px; x2 = 440px; y2 = 350px; end_arrow = triangle; line_color = hex(333); line_width = 3px; }
    put connector { from = left; to = right; kind = elbow; end_arrow = arrow; }
    put freeform { x = 500px; y = 100px; path = "M 0 0 L 100 0 L 50 80 Z"; fill = hex(9B59B6); }
    put backdrop { kind = roundRect; x = 600px; y = 300px; width = 200px; height = 100px; blur = 12px; radius = 16px; }
}
-- stddef_objects.ir --
Document
  Slide 1
    background: linear(90, rgba(255, 255, 255, 1), rgba(221, 221, 221, 1))
    Element text_box
      text:
        Paragraph
          Run "글상자"
      x: 40px
      y: 30px
      width: 400px
      height: 60px
      anchor: middle
    Element shape as left
      kind: roundRect
      x: 40px
      y: 120px
      width: 160px
      height: 100px
      text:
        Paragraph
