-- colors_gamut_warning.tlide --
/* sRGB 밖의 색은 가장 가까운 색으로 맞추고 경고한다. 경고는 IR 맨 앞의 # stderr: 줄에 남는다.
   lab, lch, oklab, oklch만 sRGB 밖일 수 있고, 같은 색을 다시 써도 경고는 자리마다 하나씩이다 */
object swatch { var color c; }

template glow {
    var color c;
    put swatch { c = c; }
}

slide {
    put swatch { c = oklch(70%, 0.4, 150deg); }
    put swatch { c = lab(50, 100, 0); }
    put swatch { c = lch(50, 130, 40deg); }
    put swatch { c = oklab(60%, 0.2, -0.3); }
    put swatch { c = oklch(70%, 0.1, 150deg); }
    put glow { c = oklch(65%, 0.35, 330deg); }
    put glow { c = oklch(65%, 0.35, 330deg); }
}
