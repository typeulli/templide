-- chart_basic.tlide --
/* chart. 데이터는 개체 안에 적는다. values는 계열마다 한 줄이고, categories를 비우면 1, 2, 3...이다 */
#include <std/stddef>

slide {
    put chart {
        kind = column; categories = ["1분기", "2분기"]; names = ["서울", "부산"]; values = [[10, 20], [8.5, 12]];
        x = 100px; y = 100px; width = 600px; height = 400px; title = "매출"; x_title = "분기"; y_title = "억 원";
        legend = top; data_labels = true; colors = [hex(2E86AB), hex(F18F01)]; range = [0, 30]; alt = "분기별 매출 막대 차트";
    }
}

target deck { path = "deck.pptx"; type = pptx; }
