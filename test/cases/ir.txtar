      text:
        Paragraph
          Run "2 / 3"
      x: 200px
    Element label
      text:
        Paragraph
          Run "쪽 "
          Field slidenum "2"
      x: 0
  Slide 3
    Element label
      text:
        Paragraph
          Run "3 / 3"
      x: 300px
    Element label
      text:
        Paragraph
          Run "쪽 "
          Field slidenum "3"
      x: 0
-- std_styles.tlide --
/* #include <std/styles>가 주는 글자 style과 색 이름. style은 글 끝까지 이어지므로 이름마다 괄호로 묶어 하나씩 본다 */
#include <std/stddef>
#include <std/styles>

slide {
    put text_box {
        x = 0px; y = 0px; width = 600px; height = 400px;
        text = (bold "굵게") (italic "기울임") (underline "밑줄") (double_underline "겹밑줄") (strike "취소선")
            (uppercase "upper") (small_caps "small") (superscript "위") (subscript "아래");
    }
    put text_box {
        x = 0px; y = 0px; width = 600px; height = 400px;
        text = (align_left "왼쪽") (align_center "가운데") (align_right "오른쪽") (align_justify "양쪽");
    }
    put text_box {
        x = 0px; y = 0px; width = 600px; height = 400px;
        text = (bold red "굵은 빨강" (reset "초기화")) (brgap(2) "줄 간격");
    }
    put text_box {
        x = 0px; y = 0px; width = 600px; height = 400px;
        text = (black "a") (silver "b") (gray "c") (white "d") (maroon "e") (red "f") (purple "g") (fuchsia "h") (green "i") (lime "j") (olive "k")
            (yellow "l") (navy "m") (blue "n") (teal "o") (aqua "p") (orange "q") (pink "r") (brown "s") (gold "t") (cyan "u") (magenta "v");
    }
}
