-- table_for_cells.tlide --
/* cell(행, 열)의 번호와 칸의 글을 for 반복과 f-string으로 만든다. 반복(template 안)에서 만든 cell 블록은 편집기에서 잠긴다 */
#include <std/stddef>

template stack {
    for (int row in 1..2) {
        put table {
            x = 10; y = row * 100; width = 200; height = 80;
            cells = [[f"행 {row}", "b"], ["c", "d"]];
            cell(row, 2) { fill = hex(ABCDEF); }
        }
    }
}

slide {
    put stack { }
}
