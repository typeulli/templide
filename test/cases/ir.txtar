-- templates_groups_names.tlide --
/* put ... as 이름 은 template이면 그룹 하나로 묶고, group as 이름 { }은 안의 개체를 묶는다. 이름 없는 template은 그냥 펼친다 */
object label { var text text; }

template pair {
    var text a;
    var text b;
    put label { text = a; }
    put label { text = b; }
}

slide {
    put pair { a = "이름 없음 1"; b = "이름 없음 2"; }
    put pair as named { a = "이름 있음 1"; b = "이름 있음 2"; }
    put label as single { text = "개체 하나"; }
    group as box {
        put label { text = "그룹 안 1"; }
        put pair { a = "그룹 안 템플릿 1"; b = "그룹 안 템플릿 2"; }
        group {
            put label { text = "그룹 안의 그룹"; }
        }
    }
}
