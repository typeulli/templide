-- table_basic.tlide --
/* table. cells는 list<list<text>>이고 칸마다 글이다. 표 속성과 cell(행, 열) 블록의 값이 IR에 그대로 나온다 (행과 열은 1부터).
   머리글, 줄무늬, 열 너비, 병합, 칸마다 다른 서식은 모두 속성이고 계산은 backend가 한다 */
#include <std/stddef>
#include <std/styles>

slide {
    put table {
        x = 80px; y = 120px; width = 1120px; height = 300px;
        cells = [
            ["이름", "1분기", "2분기"],
            ["서울", "10", bold "20"],
            ["합계", "", ""]
        ];
        col_widths = [400px, 360px, 360px];
        row_heights = [60px, 120px, 120px];
        header_rows = 1;
        header_cols = 1;
        banded_rows = true;
        fill = hex(FFFFFF);
        line_color = hex(808080);
        line_width = 2px;
        line_dash = dash;
        padding = 12px;
        anchor = top;
        align = center;
        cell(3, 2) { col_span = 2; fill = hex(EEE); anchor = bottom; }
        cell(1, 1) { align = right; line_color_bottom = hex(FF0000); line_width_bottom = 3px; padding_left = 20px; }
    }
}

target deck { path = "deck.pptx"; type = pptx; }
