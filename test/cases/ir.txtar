-- syntax_misc.tlide --
/* 문법의 자잘한 부분.
   블록 주석은 여러 줄이어도 되고 토큰 사이 어디에나 둘 수 있다. 빈 ';'는 건너뛰고, 빈 블록도 된다 */
; ;
style  empty_style  { }
object Thing_2 { var text Text; var float ratio = -0.5; }
template empty_template { }
object empty_object { }

slide {
    ;
    put /* 이름 앞 주석 */ Thing_2 /* 뒤 주석 */ {
        Text = "대소문자와 밑줄, 숫자가 든 이름";   /* 줄 끝 주석 */
        ;
        ratio = 0.50;
    }
    put
        Thing_2
        {
            Text
                =
                "줄을 바꿔 쓴 문장"
                ;
        }
    put empty_template { }
    put empty_object { }
    put Thing_2 { Text = "음수 실수"; ratio = -1.25; }
}

slide { }
slide{put Thing_2{Text="공백 없이";}}
