-- master_defaults.tlide --
/* master 매개변수의 기본값. 뒤에서부터 생략하고, python 함수처럼 이름으로 넘길 수 있다. 기본값이 모두 있으면 master.case로 쓴다 */
object label { var text text; }

master brand {
    var color accent = hex(F00);
    var string name = "기본";
    case cover {
        background = accent;
        put label { text = name; }
    }
}

slide { layout = brand.cover; }
slide { layout = brand(hex(00F)).cover; }
slide { layout = brand(hex(00F), "푸른").cover; }
slide { layout = brand(name = "이름만").cover; }
slide { layout = brand(hex(0F0), name = "둘 다").cover; }
slide { layout = brand(name = "기본", accent = hex(F00)).cover; }
