-- control_flow.tlide --
/* for와 if. slide 바로 안에는 쓸 수 없으므로 template이나 group 안에서 쓴다 */
enum mode { fast, slow }
object label { var text text; var int x = 0; }

template rows {
    var int n;
    var mode mode = fast;
    for (int i in 1..n) {
        put label { text = f"{mode} 행 {i}"; x = i * 10px; }
    }
    if (mode == slow) {
        put label { text = "느린 모드"; }
    } else if (n == 3) {
        put label { text = "세 줄"; }
    } else {
        put label { text = "그 밖"; }
    }
}

slide {
    put rows { n = 2; }
    put rows { n = 3; }
    put rows { n = 1; mode = slow; }
    group {
        for (string name in ["가", "나", "다"]) {
            put label { text = name; }
        }
        for (int i in 3..2) {
            put label { text = "범위가 비어서 실행하지 않는다"; }
        }
        for (int i in 0..1) {
            for (int j in 1..2) {
                put label { text = f"{i},{j}"; }
            }
        }
        for (color c in [hex(F00), hex(0F0)]) {
            put label { text = "색 목록"; x = 1; }
        }
        if (1 == 1) { put label { text = "참"; } }
        if (1 == 2) { put label { text = "거짓"; } }
        if ("a" == "a") { put label { text = "문자열 같음"; } }
        if (2px + 3px == 5px) { put label { text = "5px와 5px는 같다"; } }
        if (1in == 96px) { put label { text = "1in과 96px는 같다"; } }
        if (hex(F00) == rgb(255, 0, 0)) { put label { text = "색 같음"; } }
    }
}
