      align: center
      size: small
      pinned: false
      count: 1
      ratio: 50%
      note: ""
      tint: rgba(238, 238, 238, 1)
-- fields.tlide --
/* PowerPoint가 채우는 필드: @slide.number(쪽 번호)와 @date(오늘 날짜, 비교할 때는 $DATE로 바꾼다). 필드는 run과 따로 Field로 나온다 */
object label { var text text; }

slide {
    put label { text = "쪽 " @slide.number " / 날짜 " @date; }
    put label { text = style(font-weight = bold) @slide.number; }
}
slide {
    put label { text = @slide.number; }
}
