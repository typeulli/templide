      x: 10px
      y: 10px
      width: 300px
      height: 40px
      anchor: top
-- master_params.tlide --
/* 매개변수가 있는 master. 같은 값으로 쓰면 master 하나를 함께 쓰고, 값이 다르면 master가 따로 생긴다 */
object label { var text text; }

master brand {
    var color accent;
    var string name;
    case cover {
        background = accent;
        put label { text = name; }
    }
    case body {
        put label { text = f"{name} 본문"; }
    }
}

master plain {
    case blank { }
}

slide { layout = brand(hex(F00), "붉은").cover; }
slide { layout = brand(hex(F00), "붉은").body; }
slide { layout = brand(hex(00F), "푸른").cover; }
slide { layout = plain.blank; }
slide { layout = brand(hex(F00), "붉은").cover; }
-- master_params.ir --
Document
  Master plain
    Layout blank
  Master brand(rgba(255, 0, 0, 1), "붉은")
    Layout cover
      background: rgba(255, 0, 0, 1)
      Element label
        text:
          Paragraph
            Run "붉은"
    Layout body
      Element label
        text:
          Paragraph
            Run "붉은 본문"
  Master brand(rgba(0, 0, 255, 1), "푸른")
    Layout cover
      background: rgba(0, 0, 255, 1)
      Element label
        text:
          Paragraph
            Run "푸른"
    Layout body
      Element label
        text:
          Paragraph
            Run "푸른 본문"
  Slide 1 layout brand(rgba(255, 0, 0, 1), "붉은").cover
  Slide 2 layout brand(rgba(255, 0, 0, 1), "붉은").body
  Slide 3 layout brand(rgba(0, 0, 255, 1), "푸른").cover
  Slide 4 layout plain.blank
  Slide 5 layout brand(rgba(255, 0, 0, 1), "붉은").cover
-- media_decls.tlide --
/* image, video, audio로 이름 붙인 파일. 이름, file(...), image(...), 문자열 경로 어느 것으로 써도 같은 경로가 된다 (파일은 IR에서 읽지 않는다) */
#include <std/stddef>

image logo = file("pics/logo.png");
image wall = image("pics/wall.jpg");
video intro = file("clips/intro.mp4");
audio beep = file("beep.wav");

slide {
    background = wall;
    put image { data = logo; x = 10px; y = 10px; width = 100px; height = 50px; }
    put image { data = file("pics/other.png"); x = 10px; y = 80px; width = 100px; height = 50px; fit = cover; crop_left = 10%; crop_bottom = 25%; }
    put image { data = "pics/string.png"; x = 10px; y = 150px; width = 100px; height = 50px; kind = ellipse; }
    put video { data = intro; x = 200px; y = 10px; width = 320px; height = 180px; poster = logo; start = auto; loop = true; volume = 50%; trim_start = 1s; }
    put audio { data = beep; x = 600px; y = 10px; }
}

slide {
    background = image("pics/second.png");
    transition_sound = "beep.wav";
}
-- media_decls.ir --
Document
  Slide 1
    background: image("pics/wall.jpg")
    Element image
      data: image("pics/logo.png")
      x: 10px
      y: 10px
      width: 100px
      height: 50px
      fit: stretch
      crop_left: 0%
      crop_top: 0%
      crop_right: 0%
      crop_bottom: 0%
      kind: rect
    Element image
      data: image("pics/other.png")
      x: 10px
      y: 80px
      width: 100px
      height: 50px
      fit: cover
      crop_left: 10%
      crop_top: 0%
      crop_right: 0%
      crop_bottom: 25%
      kind: rect
    Element image
      data: image("pics/string.png")
      x: 10px
      y: 150px
      width: 100px
      height: 50px
      fit: stretch
      crop_left: 0%
      crop_top: 0%
      crop_right: 0%
      crop_bottom: 0%
      kind: ellipse
    Element video as video $ID
      data: "clips/intro.mp4"
      x: 200px
      y: 10px
      width: 320px
      height: 180px
      poster: image("pics/logo.png")
      start: auto
      fullscreen: false
      loop: true
      rewind: false
      hide_when_stopped: false
      volume: 50%
      trim_start: 1s
      trim_end: 0s
      fade_in: 0s
      fade_out: 0s
    Element audio as audio $ID
      data: "beep.wav"
      x: 600px
      y: 10px
      width: 48
      height: 48
      start: click_sequence
      across_slides: false
      loop: false
      rewind: false
      hide_icon: false
      volume: 100%
      trim_start: 0s
      trim_end: 0s
      fade_in: 0s
      fade_out: 0s
    animate video $ID media play after_previous
    animate audio $ID media play on_click
  Slide 2
    background: image("pics/second.png")
    transition_sound: "beep.wav"
-- sections_notes.tlide --
/* section은 뒤따르는 slide들을 묶고, comment는 발표자 메모(여러 개는 문단으로 이어진다), review는 검토 메모, hidden은 숨긴 슬라이드 */
section "시작";

slide {
    comment "첫 메모";
    comment "둘째 문단" " 이어 붙인 글";
    comment bullets ["메모 목록 1", "메모 목록 2"];
}

slide {
    hidden = true;
    advance_after = 3s;
}

section f"본문 {1 + 1}";

slide {
    hidden = false;
    review { text = "검토 의견"; author = "김"; x = 10px; y = 20px; }
    review { text = f"쪽 {@slide.page}"; }
    review { text = "위치만"; x = 50%; y = 25%; }
}

slide { }
-- sections_notes.ir --
Document
  Slide 1
    notes:
      Paragraph
        Run "첫 메모"
      Paragraph
        Run "둘째 문단"
        Run " 이어 붙인 글"
      Paragraph bullets level 0
        Run "메모 목록 1"
      Paragraph bullets level 0
        Run "메모 목록 2"
    section: "시작"
  Slide 2
    section: "시작"
    hidden: true
    advance_after: 3s
  Slide 3
    section: "본문 2"
    review "검토 의견" by "김" at 10px, 20px
    review "쪽 3" by "templide" at 0, 0
    review "위치만" by "templide" at 50%, 25%
  Slide 4
    section: "본문 2"
-- self_name.tlide --
/* @self.name은 그 put의 속성 값 안에서 put ... as 이름의 이름이 된다. 이름이 없는 put에서는 쓸 수 없다 (error 쪽에서 본다) */
object label { var text text; var string id = ""; }

template tagged {
    var string id;
    put label { text = f"id: {id}"; }
}

slide {
    put label as title { text = f"이름: {@self.name}"; id = @self.name; }
    put label as subtitle { text = "이름" ; id = f"{@self.name}-2"; }
    put tagged as card { id = @self.name; }
}
-- self_name.ir --
Document
  Slide 1
    Element label as title
      text:
        Paragraph
          Run "이름: title"
      id: "title"
    Element label as subtitle
      text:
        Paragraph
          Run "이름"
      id: "subtitle-2"
    Element group as card
      Element label
        text:
          Paragraph
            Run "id: card"
        id: ""
-- slide_context.tlide --
/* @slide.page는 정수, @slide.count는 전체 슬라이드 수, @slide.number는 PowerPoint가 채우는 필드. master에서는 page를 쓸 수 없다 */
object label { var text text; var int x = 0; }

template footer {
    put label { text = f"{@slide.page} / {@slide.count}"; x = @slide.page * 100px; }
    put label { text = "쪽 " @slide.number; }
}

master deck {
    case plain {
        put label { text = @slide.number " of " f"{@slide.count}"; }
    }
}

slide { put footer { } }
slide { layout = deck.plain; put footer { } }
slide { put footer { } }
-- slide_context.ir --
Document
  Master deck
    Layout plain
      Element label
        text:
          Paragraph
            Field slidenum "‹#›"
            Run " of "
            Run "3"
        x: 0
  Slide 1
    Element label
      text:
        Paragraph
          Run "1 / 3"
      x: 100px
    Element label
      text:
        Paragraph
          Run "쪽 "
          Field slidenum "1"
      x: 0
  Slide 2 layout deck.plain
