-- colors_theme.tlide --
/* theme.accent1 같은 테마 색은 IR에서 theme.이름으로 남고, theme 선언의 값은 master가 쓴다 */
object swatch { var color c; }

theme brand {
    dark1 = hex(111111);
    accent1 = hex(E4572E);
    accent2 = oklch(65%, 0.1, 200deg);
    hyperlink = rgb(0, 0, 238);
    heading_font = font("Georgia");
    body_font = font("Verdana");
}

master deck {
    theme = brand;
    case plain { background = theme.light2; }
    case tinted { background = linear(90, theme.accent1, theme.accent2); }
}

slide {
    layout = deck.plain;
    put swatch { c = theme.accent1; }
    put swatch { c = theme.dark1; }
    put swatch { c = theme.light1; }
    put swatch { c = theme.dark2; }
    put swatch { c = theme.light2; }
    put swatch { c = theme.accent6; }
    put swatch { c = theme.hyperlink; }
    put swatch { c = theme.followed_hyperlink; }
}

slide {
    layout = deck.tinted;
    put swatch { c = theme.accent2; }
}
