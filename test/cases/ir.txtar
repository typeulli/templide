-- animations_inline.tlide --
/* put과 group 블록 안의 animate. 개체 이름을 쓰지 않고, 이름이 없으면 컴파일러가 이름을 붙인다(IR에서는 $ID로 보인다).
   order로 slide 바로 안의 animate와 재생 차례를 섞는다 */
object label { var text text; }

slide {
    put label as first {
        text = "첫째";
        animate enter fade 0.5s;
    }
    put label as second {
        text = "둘째";
        animate enter fly.up 1s with_previous;
        animate emphasis spin delay 0.5s;
    }
    put label {
        text = "이름 없는 개체";
        animate enter appear;
    }
    group as box {
        put label { text = "그룹 안"; }
        animate enter zoom.in 1s;
    }
    group {
        put label { text = "이름 없는 그룹"; }
        animate exit fade;
    }
    animate first exit fade order 1;
    put label as late {
        text = "순서를 당긴다";
        animate enter appear order 2;
    }
}
-- animations_inline.ir --
Document
  Slide 1
    Element label as first
      text:
        Paragraph
          Run "첫째"
    Element label as second
      text:
        Paragraph
          Run "둘째"
    Element label as label $ID
      text:
        Paragraph
          Run "이름 없는 개체"
    Element group as box
      Element label
        text:
          Paragraph
            Run "그룹 안"
    Element group as group $ID
      Element label
        text:
          Paragraph
            Run "이름 없는 그룹"
    Element label as late
      text:
        Paragraph
          Run "순서를 당긴다"
    animate first exit fade on_click
    animate late enter appear on_click
    animate first enter fade 0.5s on_click
    animate second enter fly.up 1s with_previous
    animate second emphasis spin on_click delay 0.5s
    animate label $ID enter appear on_click
    animate box enter zoom.in 1s on_click
    animate group $ID exit fade on_click
-- animations_slide.tlide --
/* slide 바로 안의 animate. 효과의 옵션(.), 길이, 시작 방식, delay, 경로 이동, order로 재생 차례를 바꾼다 */
object label { var text text; }

slide {
    put label as a { text = "A"; }
    put label as b { text = "B"; }
    put label as c { text = "C"; }

    animate a enter fade 0.5s;
    animate a enter fly.left 1s with_previous delay 0.2s;
    animate b emphasis spin after_previous;
    animate b exit wipe.up 400ms on_click;
    animate b move path "M 0 0 L 100 0 L 100 100";
    animate c move circle 2s;
    animate c enter zoom;
    animate c enter appear order 1;
    animate a exit fade order 1;
    animate b emphasis growShrink order 2;
}
-- animations_slide.ir --
Document
  Slide 1
    Element label as a
      text:
        Paragraph
          Run "A"
    Element label as b
      text:
        Paragraph
          Run "B"
    Element label as c
      text:
        Paragraph
          Run "C"
    animate c enter appear on_click
    animate a exit fade on_click
    animate b emphasis growShrink on_click
    animate a enter fade 0.5s on_click
    animate a enter fly.left 1s with_previous delay 0.2s
    animate b emphasis spin after_previous
    animate b exit wipe.up 400ms on_click
    animate b move path "M 0 0 L 100 0 L 100 100" on_click
    animate c move circle 2s on_click
    animate c enter zoom.in on_click
-- asset_bundle/main.tlide --
/* asset "묶음.tasset"으로 묶음을 불러와 asset("이름")으로 쓴다. 이름은 확장자를 빼도 되고, by { ... }로 이름을 붙이거나 * as 이름으로 한꺼번에 가리킨다.
   file("묶음.tasset/파일")로 경로를 바로 쓸 수도 있다 */
#include <std/stddef>

asset "pics.tasset";
asset "pics.tasset" by { "images/photo" as pic, * as p };

slide {
    put image { data = asset("logo"); x = 0px; y = 0px; width = 10px; height = 10px; }
    put image { data = asset("logo.png"); x = 0px; y = 10px; width = 10px; height = 10px; }
    put image { data = asset("images/photo"); x = 0px; y = 20px; width = 10px; height = 10px; }
    put image { data = asset("pic"); x = 0px; y = 30px; width = 10px; height = 10px; }
    put image { data = asset("p.logo"); x = 0px; y = 40px; width = 10px; height = 10px; }
    put image { data = file("pics.tasset/logo.png"); x = 0px; y = 50px; width = 10px; height = 10px; }
}
