/* png target. scale(배율, 기본 1)과 transparent(슬라이드 배경을 그리지 않는다, 기본 거짓)는 png만 쓴다. 슬라이드마다 파일 하나가 만들어진다 */
#include <std/stddef>

slide { put text_box { text = "x"; x = 0; y = 0; width = 100; height = 20; } }

