-- templates_nested.tlide --
/* template 펼치기. template 안에서 template을 put하고, var는 안쪽으로 넘어가며 기본값은 put마다 따로 쓰인다 */
object label { var text text; var int x; var int y; }

template tag {
    var text name;
    var int x;
    var int y;
    var color ink = hex(333);
    put label { text = style(color = ink) name; x = x; y = y; }
}

template pair {
    var text left;
    var text right;
    var int x;
    var int y;
    var int gap = 20px;
    put tag { name = left; x = x; y = y; }
    put tag { name = right; x = x + 100px + gap; y = y; ink = hex(F00); }
}

template grid {
    var int x;
    var int y;
    put pair { left = "A"; right = "B"; x = x; y = y; }
    put pair { left = "C"; right = "D"; x = x; y = y + 40px; gap = 0px; }
}

slide {
    put pair { left = "왼쪽"; right = "오른쪽"; x = 10px; y = 10px; }
    put grid { x = 200px; y = 100px; }
}
