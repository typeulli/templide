-- targets.tlide --
/* target. type은 pptx, html, web, pdf이고 크기는 width와 height를 함께 쓰며, angles = css면 각도가 css 방식이다. 쓰는 master는 slide의 layout에서 모은다 */
object label { var text text; }

master first { case a { } }
master second { case b { } }

slide { layout = second.b; put label { text = "둘째 master 먼저"; } }
slide { layout = first.a; }
slide { layout = second.b; }

target minimal { path = "min.pptx"; type = pptx; }
target full {
    path = "full.pptx";
    type = pptx;
    title = "문서 제목";
    author = "작성자";
    width = 1280px;
    height = 720px;
}
target page { path = "page.html"; type = html; angles = css; loop = true; width = 10in; height = 5.625in; }
target folder { path = "site"; type = web; }
target paper { path = "paper.pdf"; type = pdf; width = 11in; height = 8.5in; angles = powerpoint; }
