-- text_composition.tlide --
/* text를 만드는 여러 방법. string과 text와 var가 한 text 안에서 이어 붙고, 빈 문자열은 run을 만들지 않는다 */
style bold { font-weight = bold; }
style red { color = hex(F00); }
object label { var text text; }

template frame {
    var text title;
    var text detail = "";
    put label { text = bold title; }
    put label { text = detail; }
}

slide {
    put label { text = "A" "B" "C"; }
    put label { text = "" "빈 문자열은" "" " 건너뛴다" ""; }
    put frame { title = "제목"; detail = "자세히"; }
    put frame { title = red "빨간 " "제목"; }
    put frame { title = "var 안의 목록"; detail = bullets ["가", "나"]; }
    put label { text = red "앞 " ("괄호 안 " bold "굵게 ") "괄호 밖"; }
}
