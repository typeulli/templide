        Paragraph
          Run "쪽 "
          Field slidenum "1"
          Run " / 날짜 "
          Field datetime1 "$DATE"
    Element label
      text:
        Paragraph
          Field slidenum "1" [font-weight: bold]
  Slide 2
    Element label
      text:
        Paragraph
          Field slidenum "2"
-- include_relative/main.tlide --
/* #include "경로"는 이 파일이 있는 폴더 기준이고 .tlide는 붙이지 않는다. 같은 파일을 여러 번 불러도 한 번만 읽고 (_a와 _b가 모두 _common을 부른다),
   패키지(#include <std/stddef>)와 하위 폴더(lib/_shapes)도 같다 */
#include <std/stddef>
#include "_a"
#include "_b"
#include "lib/_shapes"
#include <std/stddef>

slide {
    put badge { label = "포함한 template"; }
    put dot { x = 10px; y = 20px; }
    put text_box { text = accent "stddef도 쓴다"; x = 0px; y = 100px; width = 200px; height = 30px; }
}
-- include_relative/main.ir --
Document
  Slide 1
    Element text_box
      text:
        Paragraph
          Run "포함한 template" [color: rgba(18, 52, 86, 1)]
      x: 0px
      y: 0px
      width: 200px
      height: 30px
      anchor: top
    Element dot
      x: 10px
      y: 20px
    Element text_box
      text:
        Paragraph
          Run "stddef도 쓴다" [font-weight: bold]
      x: 0px
      y: 100px
      width: 200px
      height: 30px
      anchor: top
-- include_relative/_a.tlide --
#include <std/stddef>
#include "_common"

style accent { font-weight = bold; }
-- include_relative/_b.tlide --
#include "_common"

template badge {
    var text label;
    put text_box { text = brand label; x = 0px; y = 0px; width = 200px; height = 30px; }
}
-- include_relative/_common.tlide --
style brand { color = hex(123456); }
-- include_relative/lib/_shapes.tlide --
object dot {
    var int x;
    var int y;
}
-- links.tlide --
/* 개체의 link와 text 안의 link(...). 대상은 주소, 슬라이드 번호, 이동 이름이다.
   action은 IR 출력에 내용이 찍히지 않으므로 pptx와 html 케이스에서 본다 */
object tile { var text text; }
object label { var text text; }

slide {
    put tile { text = "주소"; link = "https://example.com/a?b=1"; }
    put tile { text = "슬라이드"; link = slide(2); }
    put tile { text = "다음"; link = next_slide; }
    put tile { text = "이전"; link = previous_slide; }
    put tile { text = "처음"; link = first_slide; }
    put tile { text = "끝"; link = end_show; }
    put label { text = "앞 " link("https://example.org") "링크 글자" " 뒤"; }
    put label { text = "앞 " link(slide(2)) "슬라이드 링크"; }
    put label { text = link(last_slide) "마지막 슬라이드" style(color = hex(00F)) " 파란 글자"; }
}

slide {
    put label { text = "둘째 슬라이드"; }
}
-- links.ir --
Document
  Slide 1
    Element tile
      text:
        Paragraph
          Run "주소"
      link: "https://example.com/a?b=1"
    Element tile
      text:
        Paragraph
          Run "슬라이드"
      link: slide(2)
    Element tile
      text:
        Paragraph
          Run "다음"
      link: next_slide
    Element tile
      text:
        Paragraph
          Run "이전"
      link: previous_slide
    Element tile
      text:
        Paragraph
          Run "처음"
      link: first_slide
    Element tile
      text:
        Paragraph
          Run "끝"
      link: end_show
    Element label
      text:
        Paragraph
          Run "앞 "
          Run "링크 글자" [link: "https://example.org"]
          Run " 뒤" [link: "https://example.org"]
    Element label
      text:
        Paragraph
          Run "앞 "
          Run "슬라이드 링크" [link: slide(2)]
    Element label
      text:
        Paragraph
          Run "마지막 슬라이드" [link: last_slide]
          Run " 파란 글자" [color: rgba(0, 0, 255, 1), link: last_slide]
  Slide 2
    Element label
      text:
        Paragraph
          Run "둘째 슬라이드"
-- master_layouts.tlide --
/* master와 case(layout). layout의 개체 틀(placeholder)은 slide의 title, subtitle, body로 채우고, layout이 없는 slide도 있다 */
#include <std/stddef>

theme calm {
    accent1 = hex(2E86AB);
    heading_font = font("Georgia");
}

master deck {
    theme = calm;
    case cover {
        background = hex(F5F5F5);
        put placeholder { role = title; x = 100px; y = 200px; width = 1080px; height = 120px; text = "제목을 입력"; }
        put placeholder { role = subtitle; x = 100px; y = 340px; width = 1080px; height = 60px; }
    }
    case content {
        put placeholder { role = title; x = 60px; y = 30px; width = 1160px; height = 80px; }
        put placeholder { role = body; x = 60px; y = 130px; width = 1160px; height = 520px; anchor = top; }
        put text_box { text = @slide.number; x = 1180px; y = 680px; width = 60px; height = 30px; }
    }
}

slide {
    layout = deck.cover;
    title = "표지 제목";
    subtitle = style(color = hex(777)) "부제";
}

slide {
    layout = deck.content;
    title = "본문 제목";
    body = bullets ["첫째", "둘째"];
}

slide {
    layout = deck.content;
}

slide {
    put text_box { text = "layout 없는 슬라이드"; x = 10px; y = 10px; width = 300px; height = 40px; }
}
