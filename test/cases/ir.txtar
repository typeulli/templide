-- text_styles.tlide --
/* style 선언과 호출. 이어 붙인 style은 text 끝까지 누적되고, 뒤의 것이 앞의 것을 덮어쓴다 */
style bold { font-weight = bold; }
style plain { font-weight = normal; color = hex(000); }
style red { color = hex(F00); }
style size(float s) { font-size = s; }
style tint(color c) { color = c; }
style serif { font-family = font("Georgia"); font-style = italic; text-decoration = underline; }
style spaced { letter-spacing = 2px; text-transform = uppercase; highlight = hex(FF0); vertical-align = super; }
style para { text-align = center; line-height = 1.5; space-before = 6pt; space-after = 1in; margin-left = 24px; text-indent = -12px; }
color brand rgb(10, 20, 30);

object label { var text text; }

slide {
    put label { text = bold "굵게" plain " 보통" red " 빨강"; }
    put label { text = size(12pt) "작게 " size(2 * 12pt) "크게"; }
    put label { text = tint(hex(00F)) "파랑 " tint(rgb(0, 128, 0)) "초록" brand " color 선언"; }
    put label { text = serif "세리프" spaced " 간격"; }
    put label { text = para "문단 속성"; }
    put label { text = "스타일 없음"; }
}
-- text_styles.ir --
Document
  Slide 1
    Element label
      text:
        Paragraph
          Run "굵게" [font-weight: bold]
          Run " 보통" [color: rgba(0, 0, 0, 1), font-weight: normal]
          Run " 빨강" [color: rgba(255, 0, 0, 1), font-weight: normal]
    Element label
      text:
        Paragraph
          Run "작게 " [font-size: 16px]
          Run "크게" [font-size: 32px]
    Element label
      text:
        Paragraph
          Run "파랑 " [color: rgba(0, 0, 255, 1)]
          Run "초록" [color: rgba(0, 128, 0, 1)]
          Run " color 선언" [color: rgba(10, 20, 30, 1)]
    Element label
      text:
        Paragraph
          Run "세리프" [font-family: "Georgia", font-style: italic, text-decoration: underline]
          Run " 간격" [font-family: "Georgia", font-style: italic, text-decoration: underline, vertical-align: super, letter-spacing: 2px, highlight: rgba(255, 255, 0, 1), text-transform: uppercase]
    Element label
