-- text_lists.tlide --
/* bullets, numbers, dashes, paragraphs. 목록 뒤에 오는 글은 새 문단이고, 번호 모양은 style로 바꾼다 */
style roman { list-style = upper_roman; list-start = 3; }
style marker { list-marker = "▶"; list-marker-color = hex(F00); }
style bold { font-weight = bold; }
object label { var text text; }

slide {
    put label { text = bullets ["첫째", "둘째", "셋째"]; }
    put label { text = numbers ["하나", "둘", "셋"]; }
    put label { text = dashes ["가", "나"]; }
    put label { text = paragraphs ["문단 하나", "문단 둘"]; }
    put label { text = "앞 글" bullets ["항목"] "뒤 글"; }
    put label { text = roman numbers ["로마 숫자", "3부터"]; }
    put label { text = marker bullets ["사용자 기호", "색도 지정"]; }
    put label { text = bullets [bold "굵은 " "항목", "일반 항목"]; }
    put label { text = bullets []; }
}
