-- enums_vars.tlide --
/* enum 선언, var의 기본값과 필수 var. enum 값은 var 타입이 알려 주므로 이름만 적는다 */
enum align { left, center, right }
enum size { small, medium, large }

object card {
    var text title;
    var align align = left;
    var size size = medium;
    var bool pinned = false;
    var int count = 1;
    var float ratio = 50%;
    var string note = "";
    var color tint = hex(EEE);
}

slide {
    put card { title = "기본값만"; }
    put card { title = "전부 지정"; align = right; size = large; pinned = true; count = 3; ratio = 25%; note = "메모"; tint = hex(F00); }
    put card { title = "enum만"; size = small; align = center; }
}
-- enums_vars.ir --
