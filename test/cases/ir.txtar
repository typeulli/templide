-- math_basic.tlide --
/* math. latex는 LaTeX 수식이고 \는 \\로 적는다. font_size, text_color, align, anchor는 선택이다 */
#include <std/stddef>

slide {
    put math { latex = "\\frac{a}{b} + \\sqrt{x}"; x = 100px; y = 100px; width = 600px; height = 120px; font_size = 40px; text_color = hex(2E86AB); align = left; alt = "분수와 제곱근"; }
}

target deck { path = "deck.pptx"; type = pptx; }
