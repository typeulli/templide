-- text_fstring_escapes.tlide --
/* f-string과 이스케이프. \n은 문단 안의 줄바꿈이고 \" \\ \{ \} \t는 글자 그대로 들어간다 */
object label { var text text; }

template count_label {
    var int n;
    var string unit = "개";
    put label { text = f"{n}{unit}"; }
}

slide {
    put label { text = "줄 하나\n줄 둘"; }
    put label { text = "따옴표 \" 역슬래시 \\ 중괄호 \{ \} 탭 \t 끝"; }
    put label { text = f"쪽 {@slide.page} / {@slide.count}"; }
    put label { text = f"계산 {1 + 2 * 3} 그리고 {10px - 4px} 그리고 {2 * 5px}"; }
    put label { text = f"f-string 안의 이스케이프 \{중괄호\} \"따옴표\" \\"; }
    put label { text = f"참 거짓: {1 == 1} {2 == 3} {true}"; }
    put label { text = f""; }
    put count_label { n = 3; }
    put count_label { n = 12; unit = "명"; }
}
