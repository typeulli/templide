-- text_inline_style.tlide --
/* text 안에 바로 쓰는 style(...). 이름 있는 style과 섞어 쓰고, 속성 값에 template의 var를 쓸 수 있다 */
style bold { font-weight = bold; }
object label { var text text; }

template note {
    var text body;
    var color ink = hex(333);
    put label { text = style(color = ink, font-size = 14pt) body; }
}

slide {
    put label { text = style(color = hex(F00), font-size = 20pt) "빨간 큰 글자" style(font-weight = bold) "굵게도"; }
    put label { text = bold style(text-decoration = line_through) "이름 있는 style과 함께"; }
    put label { text = style() "빈 style"; }
    put label { text = style(color = hex(111)) "앞" style(color = hex(222)) "뒤"; }
    put note { body = "기본 색"; }
    put note { body = "지정한 색"; ink = oklch(60%, 0.1, 30deg); }
    put label { text = bullets [style(color = hex(0A0)) "목록 항목", "스타일 없는 항목"]; }
}
-- text_inline_style.ir --
