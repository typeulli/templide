-- text_nested_lists.tlide --
/* 목록 안의 목록은 한 단계씩 깊어지고, paragraphs는 깊이를 바꾸지 않는다 */
object label { var text text; }

slide {
    put label {
        text = bullets [
            "1단계",
            numbers ["2단계 번호 1", "2단계 번호 2", dashes ["3단계 줄표"]],
            "다시 1단계"
        ];
    }
    put label {
        text = bullets [
            "문단을 담은 목록",
            paragraphs ["기호 없는 문단", "깊이는 그대로"]
        ];
    }
    put label {
        text = numbers [
            "앞",
            bullets ["안쪽 기호", bullets ["더 안쪽"]],
            "뒤"
        ];
    }
}
