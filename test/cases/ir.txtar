-- table_list_vars.tlide --
/* list<T> 타입. template의 var가 list<list<text>>, list<float>를 받아 표에 넘긴다. 기본값 [ ... ]도 쓴다.
   표의 칸은 text라서 문자열, style(...), 이름 붙인 style을 이어 쓸 수 있다 */
#include <std/stddef>

style red { color = hex(C0392B); }

template grid {
    var list<list<text>> rows;
    var list<float> widths = [100px, 200px];
    put table { x = 0; y = 0; width = 300; height = 100; cells = rows; col_widths = widths; }
}

slide {
    put grid { rows = [["a", "b"], ["c", red "d"]]; }
    put grid { rows = [["x", "y"]]; widths = [50px, 50px]; }
}
