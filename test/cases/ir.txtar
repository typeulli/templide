    Element label
      text:
        Paragraph
          Run "스타일 없음"
-- transitions.tlide --
/* 화면 전환: 효과 이름, 옵션(.), 길이. 옵션을 안 쓰면 첫 옵션이 기본이고, 길이를 안 쓰면 비워 둔다 */
slide { transition fade; }
slide { transition fade 0.5s; }
slide { transition fade.through_black 1s; }
slide { transition cut; }
slide { transition wipe.left 250ms; }
slide { transition push; }
slide { transition cover.right_up 2s; }
slide { transition random; }
slide { transition split.vertical_in 1s; }
slide { transition morph.by_word 0.8s; }
slide { transition checkerboard.down; }
slide { transition fade 1s + 500ms; advance_after = 3s; }
slide { advance_after = 1500ms; }
-- transitions.ir --
Document
  Slide 1
    transition: fade.smoothly
  Slide 2
    transition: fade.smoothly 0.5s
  Slide 3
    transition: fade.through_black 1s
  Slide 4
    transition: cut.smoothly
  Slide 5
    transition: wipe.left 250ms
  Slide 6
    transition: push.left
  Slide 7
    transition: cover.right_up 2s
  Slide 8
    transition: random
  Slide 9
    transition: split.vertical_in 1s
  Slide 10
    transition: morph.by_word 0.8s
  Slide 11
    transition: checkerboard.down
  Slide 12
    transition: fade.smoothly 1s+500ms
    advance_after: 3s
  Slide 13
    advance_after: 1500ms
-- units_angles_durations.tlide --
/* 각도(단위 없음 또는 deg), 시간(s, ms), 0~1 비율(opacity), 선 굵기 같은 길이 속성 */
object m { }

slide {
    put m as box { rotation = 45; opacity = 0.5; }
    put m { rotation = 45deg; opacity = 1; }
    put m { rotation = -30deg; opacity = 0; line_width = 2pt; }
    put m { rotation = 450; glow = hex(0F0); glow_size = 1cm; shadow = hex(000); shadow_blur = 4px; shadow_distance = 3pt; shadow_angle = 135; }
    put m { fill = linear(90, hex(F00), hex(00F)); }
    put m { fill = linear(45deg, hex(F00) 10%, hex(0F0) 60%, hex(00F)); }
    transition fade 500ms;
    animate box enter fade 0.25s delay 1s;
}
-- units_angles_durations.ir --
Document
  Slide 1
    transition: fade.smoothly 500ms
    Element m as box
      rotation: 45
      opacity: 0.5
    Element m
      rotation: 45deg
      opacity: 1
    Element m
      rotation: -30deg
      line_width: 2.66666666666667px
      opacity: 0
    Element m
      rotation: 450
      shadow: rgba(0, 0, 0, 1)
      shadow_blur: 4px
      shadow_distance: 4px
      shadow_angle: 135
      glow: rgba(0, 255, 0, 1)
      glow_size: 37.7952755905512px
    Element m
      fill: linear(90, rgba(255, 0, 0, 1), rgba(0, 0, 255, 1))
    Element m
      fill: linear(45deg, rgba(255, 0, 0, 1) 10%, rgba(0, 255, 0, 1) 60%, rgba(0, 0, 255, 1))
    animate box enter fade 0.25s on_click delay 1s
-- units_arithmetic.tlide --
/* 단위가 있는 수의 계산. 같은 단위끼리 합치고, %와 px는 항으로 따로 남기고, 곱은 한쪽에만 단위가 있어야 한다 */
object m { var float v; }
object n { var int v; }

slide {
    put m { v = 5px + 1in; }
    put m { v = 100% - 20px; }
    put m { v = 10 + 5px; }
    put m { v = 3 * 20px; }
    put m { v = 20px * 3; }
    put m { v = 1.5 * 10pt; }
    put m { v = (1in + 2px) * 2; }
    put m { v = 10px - 10px; }
    put m { v = 50% + 25% - 10px + 4px; }
    put m { v = 1 + 2 * 3; }
    put m { v = (1 + 2) * 3; }
    put m { v = 2 * -3px; }
    put m { v = 10px - 15px; }
    put n { v = 7; }
    put n { v = 2 * 3 + 1; }
    put n { v = 12.5%; }
}
-- units_arithmetic.ir --
Document
  Slide 1
    Element m
      v: 101px
    Element m
      v: 100%-20px
    Element m
      v: 15px
    Element m
      v: 60px
    Element m
      v: 60px
    Element m
      v: 20px
    Element m
      v: 196px
    Element m
      v: 0
    Element m
      v: 75%-6px
    Element m
      v: 7
    Element m
      v: 9
    Element m
      v: -6px
    Element m
      v: -5px
    Element n
      v: 7
    Element n
      v: 7
    Element n
      v: 12.5%
-- units_conversion.tlide --
/* 길이 단위. pt, in, cm, mm는 px로 바뀌고 %는 그대로 두며, 단위가 없는 수는 px로 본다 */
object m { var float v; }

slide {
    put m { v = 10px; }
    put m { v = 12pt; }
    put m { v = 1in; }
    put m { v = 2.54cm; }
    put m { v = 25.4mm; }
    put m { v = 50%; }
    put m { v = 10; }
    put m { v = 1.5; }
    put m { v = 0; }
    put m { v = 0px; }
    put m { v = -10px; }
    put m { v = -1.5pt; }
    put m { v = -25%; }
    put m { v = 33.3%; }
}
