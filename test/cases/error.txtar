-- math_syntax_errors.tlide --
/* LaTeX 문법 오류는 target과 상관없이 오류다 */
#include <std/stddef>
slide {
    put math { latex = "\\frac{a}{b"; x = 0; y = 0; width = 100; height = 100; }
    put math { latex = "x^2^3"; x = 0; y = 0; width = 100; height = 100; }
    put math { latex = "\\left( x"; x = 0; y = 0; width = 100; height = 100; }
    put math { latex = "\\begin{pmatrix} a \\end{bmatrix}"; x = 0; y = 0; width = 100; height = 100; }
    put math { latex = "a }"; x = 0; y = 0; width = 100; height = 100; }
    put math { latex = "\\frac{1}"; x = 0; y = 0; width = 100; height = 100; }
}
-- math_syntax_errors.expected --
$ templide math_syntax_errors.tlide --check
[exit] 1
[stderr]
math_syntax_errors.tlide:4:24: error[E2172]: The LaTeX has a syntax error: Missing '}'
math_syntax_errors.tlide:5:24: error[E2172]: The LaTeX has a syntax error: Double superscript
math_syntax_errors.tlide:6:24: error[E2172]: The LaTeX has a syntax error: Missing \right
math_syntax_errors.tlide:7:24: error[E2172]: The LaTeX has a syntax error: \begin{pmatrix} is closed by \end{bmatrix}
math_syntax_errors.tlide:8:24: error[E2172]: The LaTeX has a syntax error: Unexpected '}'
math_syntax_errors.tlide:9:24: error[E2172]: The LaTeX has a syntax error: Missing argument for \frac
