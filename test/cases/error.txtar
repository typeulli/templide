-- action_without_call.tlide --
/* run()에 함수 이름이 없음 */
object tile { var text text; }
slide {
    put tile { text = "x"; action = run(); }
}
-- action_without_call.expected --
$ templide action_without_call.tlide --check
[exit] 1
[stderr]
action_without_call.tlide:4:37: error[E2088]: run needs a function name and optional arguments, such as run("onClick", @slide.number)
