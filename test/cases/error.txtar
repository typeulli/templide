}
-- math_empty.expected --
$ templide math_empty.tlide --check
[exit] 1
[stderr]
math_empty.tlide:4:24: error[E2174]: The LaTeX is empty
-- math_unsupported_pptx.tlide --
/* PowerPoint 수식으로 쓸 수 없는 명령은 pptx를 만드는 문서에서만 오류다 */
#include <std/stddef>
slide {
    put math { latex = "a \\xrightarrow{f} b"; x = 0; y = 0; width = 100; height = 100; }
    put math { latex = "\\begin{aligned} a &= b \\end{aligned}"; x = 0; y = 0; width = 100; height = 100; }
}
target out { path = "out.pptx"; type = pptx; }
-- math_unsupported_pptx.expected --
$ templide math_unsupported_pptx.tlide --check
[exit] 1
[stderr]
math_unsupported_pptx.tlide:4:24: error[E2173]: The LaTeX '\xrightarrow' cannot be written as a PowerPoint equation; remove it, or remove pptx from the targets
math_unsupported_pptx.tlide:5:24: error[E2173]: The LaTeX '\begin{aligned}' cannot be written as a PowerPoint equation; remove it, or remove pptx from the targets
-- math_unsupported_html.tlide --
/* pptx가 없으면 KaTeX가 읽을 수 있는 명령은 그대로 쓴다 */
#include <std/stddef>
slide {
    put math { latex = "a \\xrightarrow{f} b"; x = 0; y = 0; width = 100; height = 100; }
}
target page { path = "page.html"; type = html; }
-- math_unsupported_html.expected --
$ templide math_unsupported_html.tlide --check
[exit] 0
[stdout]
page: ok
