-- warning_run_in_pptx.tlide --
/* run(...)은 pptx에서 무시되므로 경고하고 종료 코드는 0이다 */
#include <std/stddef>
slide {
    put text_box { text = "x"; x = 0; y = 0; width = 10; height = 10; action = run("onClick"); }
}
target deck { path = "a.pptx"; type = pptx; }
-- warning_run_in_pptx.expected --
$ templide warning_run_in_pptx.tlide --check
[exit] 0
[stdout]
deck: ok
[stderr]
warning_run_in_pptx.tlide:4:80: warning[W3001]: run("onClick") calls a JS function, which only works in html and web; the pptx target 'deck' ignores it
-- warning_script_in_pptx.tlide --
/* script는 html과 web만 읽으므로 pptx에서는 경고 */
slide { }
target deck { path = "a.pptx"; type = pptx; script = "a.js"; }
-- warning_script_in_pptx.expected --
$ templide warning_script_in_pptx.tlide --check
[exit] 0
[stdout]
deck: ok
[stderr]
warning_script_in_pptx.tlide:3:54: warning[W3003]: script is only loaded by html and web targets; the pptx target 'deck' ignores it
