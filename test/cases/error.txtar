-- chart_scatter_xs.tlide --
/* 산점도의 xs: 없거나, 계열 수나 점의 수가 다름 */
#include <std/stddef>
slide {
    put chart { kind = scatter; values = [[1, 2]]; x = 0; y = 0; width = 100; height = 100; }
    put chart { kind = scatter; values = [[1, 2], [3, 4]]; xs = [[1, 2]]; x = 0; y = 0; width = 100; height = 100; }
    put chart { kind = scatter; values = [[1, 2]]; xs = [[1, 2, 3]]; x = 0; y = 0; width = 100; height = 100; }
}
