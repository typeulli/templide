-- fields.tlide --
/* html에서 @slide.number와 @date는 run의 fld 값(slidenum, datetime1)으로 나온다. 날짜 글자는 $DATE로 바꿔 비교한다 */
#include <std/stddef>

slide {
    put text_box { text = "쪽 " @slide.number " / 날짜 " @date; x = 10px; y = 10px; width = 400px; height = 30px; }
}

target out { path = "fields.html"; type = html; }
