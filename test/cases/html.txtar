-- transitions_animations.tlide --
/* 화면 전환(tr), 자동 넘김(adv), 애니메이션(an: 개체 번호, 효과 키, 시작 방식, 길이와 지연), 발표자 메모(notes), 구역(sec), 숨김(hid) */
#include <std/stddef>

section "시작";

slide {
    transition fade.through_black 1s;
    advance_after = 4s;
    put text_box as a { text = "A"; x = 20px; y = 20px; width = 200px; height = 40px; }
    put shape as b { kind = ellipse; x = 20px; y = 80px; width = 60px; height = 60px; }
    animate a enter fade 0.5s;
    animate a enter fly.left 1s with_previous delay 0.2s;
    animate b emphasis spin after_previous;
    animate b exit wipe.up 400ms on_click;
    animate b move path "M 0 0 L 100 0 L 100 100";
    comment "발표자 메모";
}

section "다음";

slide {
    hidden = true;
    transition push.down;
}

slide {
    transition wipe.right 250ms;
    review { text = "검토"; author = "김"; x = 10px; y = 20px; }
}

target out { path = "transitions_animations.html"; type = html; loop = true; }
