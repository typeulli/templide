-- actions_script/main.tlide --
/* html에서는 run(...)이 target의 script에 든 JS 함수를 부른다 (k: 누를 때, kh: 마우스를 올릴 때). 링크와 파일 열기는 주소로 나온다 */
#include <std/stddef>

slide {
    put text_box { text = "run"; x = 10px; y = 10px; width = 100px; height = 30px; action = run("onClick", @slide.number, 1, 2.5, true, "s", 10px); }
    put text_box { text = "주소"; x = 10px; y = 50px; width = 100px; height = 30px; link = "https://example.com/a?b=1&c=2"; }
    put text_box { text = "슬라이드 2"; x = 10px; y = 90px; width = 100px; height = 30px; link = slide(2); }
    put text_box { text = "다음"; x = 10px; y = 130px; width = 100px; height = 30px; link = next_slide; }
    put shape { kind = rect; x = 150px; y = 10px; width = 100px; height = 30px; action = action_file("docs/report.pdf"); }
    put shape { kind = rect; x = 150px; y = 50px; width = 100px; height = 30px; hover_action = run("onHover"); action_highlight = true; }
    put text_box { text = action(run("go", 7)) "글자 실행" hover_action(slide(1)) " 올리면"; x = 300px; y = 10px; width = 300px; height = 30px; }
    put text_box { text = "앞 " link("https://example.org") "링크 글자"; x = 300px; y = 50px; width = 300px; height = 30px; }
}

slide {
    put text_box { text = "둘째"; x = 10px; y = 10px; width = 100px; height = 30px; }
}

target out { path = "page.html"; type = html; script = "app.js"; }
