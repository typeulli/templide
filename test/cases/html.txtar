-- master_layouts.tlide --
/* layout(개체 틀과 배경)은 layouts에, 테마 색은 themes에, slide의 title과 body는 개체 틀을 채운 개체로 나온다 */
#include <std/stddef>

theme calm {
    accent1 = hex(2E86AB);
    heading_font = font("Georgia");
}

master deck {
    theme = calm;
    case content {
        background = hex(F5F5F5);
        put placeholder { role = title; x = 60px; y = 30px; width = 1160px; height = 80px; }
        put placeholder { role = body; x = 60px; y = 130px; width = 1160px; height = 520px; }
        put text_box { text = @slide.number; x = 1180px; y = 680px; width = 60px; height = 30px; }
    }
}

slide {
    layout = deck.content;
    title = "본문 제목";
    body = bullets ["첫째", "둘째"];
    put shape { kind = rect; x = 60px; y = 660px; width = 100px; height = 20px; fill = theme.accent1; }
}

target out { path = "master_layouts.html"; type = html; }
