-- table_basic.tlide --
/* 표 하나의 덱 JSON. t = "tbl", cols와 rows(px), 병합에 가려진 칸을 뺀 cells(r, c, rs, cs, 채우기 f, 선 b, 여백 ins, 글 tx) */
#include <std/stddef>
#include <std/styles>

slide {
    put table {
        x = 80px; y = 120px; width = 1000px; height = 300px;
        cells = [
            ["이름", "1분기", "2분기", "비고"],
            ["서울", "10", bold "20", "긴 글이 들어가면 행이 늘어난다"],
            ["부산", "5", "7", ""],
            ["합계", "", "", ""]
        ];
        col_widths = [300px, 200px, 200px, 300px];
        header_rows = 1;
        header_cols = 1;
        banded_rows = true;
        line_color = hex(808080);
        padding = 10px;
        align = center;
        cell(4, 2) { col_span = 2; fill = hex(FFE699); anchor = bottom; }
        cell(2, 4) { row_span = 2; fill = hex(C6E0B4); line_color = hex(FF0000); line_width = 3px; align = left; }
        cell(1, 1) { line_color_bottom = hex(0000FF); line_width_bottom = 4px; padding_left = 24px; }
    }
}

target page { path = "table.html"; type = html; }
