-- charts_kinds.tlide --
/* 차트 여섯 종류. html은 SVG로 그릴 데이터(t: cht)를 덱에 넣고, pptx는 PowerPoint의 차트 파트와 데이터 통합 문서를 만든다 */
#include <std/stddef>

slide {
    put chart { kind = column; categories = ["가", "나"]; names = ["A", "B"]; values = [[1, 2], [3, 4]]; x = 0px; y = 0px; width = 400px; height = 300px; title = "막대"; x_title = "범주"; y_title = "값"; data_labels = true; }
    put chart { kind = bar; categories = ["가", "나"]; values = [[1, 2], [3, 4]]; stacked = true; legend = right; x = 400px; y = 0px; width = 400px; height = 300px; colors = [hex(2E86AB)]; }
    put chart { kind = line; categories = ["월", "화", "수"]; values = [[1, 3, 2]]; smooth = true; markers = false; x = 0px; y = 300px; width = 400px; height = 300px; range = [0, 4]; }
    put chart { kind = area; categories = ["월", "화", "수"]; names = ["a", "b"]; values = [[1, 3, 2], [2, 1, 3]]; stacked = true; legend = none; gridlines = false; x = 400px; y = 300px; width = 400px; height = 300px; }
    put chart { kind = pie; categories = ["가", "나", "다"]; values = [[50, 30, 20]]; data_labels = true; legend = left; x = 800px; y = 0px; width = 400px; height = 300px; }
    put chart { kind = scatter; names = ["점"]; values = [[1, 4, 2]]; xs = [[1, 2, 3]]; x = 800px; y = 300px; width = 400px; height = 300px; legend = bottom; }
}

target page { path = "page.html"; type = html; }
