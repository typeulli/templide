-- web_index/main.tlide --
/* type = web은 path 폴더에 index.html과 라이브러리를 쓰고, 그림은 media 폴더의 파일을 가리킨다 (덱 JSON은 html과 같은 모양이다) */
#include <std/stddef>

slide {
    put image { data = file("pic.png"); x = 20px; y = 20px; width = 200px; height = 100px; }
    put text_box { text = "web"; x = 20px; y = 140px; width = 200px; height = 30px; }
}

target out { path = "site"; type = web; }
