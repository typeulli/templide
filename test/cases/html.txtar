-- math_basic.tlide --
/* 수식. html은 LaTeX 글(ltx)을 덱에 넣고 KaTeX가 그린다 (t: mth). 글자 크기(fs)와 색(tc), 가로와 세로 위치(ha, va)도 함께 간다 */
#include <std/stddef>

slide {
    put math { latex = "E = mc^2"; x = 0px; y = 0px; width = 400px; height = 100px; }
    put math { latex = "\\sum_{i=1}^{n} i^2"; x = 0px; y = 100px; width = 400px; height = 100px; font_size = 24px; text_color = hex(2E86AB); align = left; anchor = top; }
}

target page { path = "page.html"; type = html; }
