-- text_shapes.tlide --
/* html은 슬라이드를 덱 JSON(templide-deck)으로 파일 하나에 담는다. 위치와 크기는 px, 글자는 문단과 run으로 나온다 */
#include <std/stddef>

style big { font-size = 32pt; font-weight = bold; color = hex(C0392B); }

slide {
    background = hex(F8F9FA);
    put text_box { text = big "제목" " 이어지는 글"; x = 40px; y = 30px; width = 600px; height = 80px; anchor = middle; }
    put text_box { text = bullets ["첫째", numbers ["안쪽 번호"], "셋째"]; x = 40px; y = 130px; width = 400px; height = 200px; }
    put shape { kind = roundRect; x = 480px; y = 130px; width = 160px; height = 100px; radius = 12px; fill = linear(90, hex(3498DB), hex(2C3E50)); line_color = hex(111111); line_width = 2px; text = "도형"; }
    put shape { kind = star5; x = 660px; y = 130px; width = 100px; height = 100px; fill = rgba(241, 196, 15, 0.8); shadow = hex(000000); shadow_blur = 6px; shadow_distance = 4px; rotation = 15; }
    put line { x1 = 40px; y1 = 360px; x2 = 440px; y2 = 360px; end_arrow = triangle; }
}

target out { path = "text_shapes.html"; type = html; title = "시험 문서"; author = "작성자"; }
