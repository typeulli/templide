-- actions_script/app.js --
function onClick(page, n, ratio, flag, text, size) {
    console.log("click", page, n, ratio, flag, text, size);
}
function onHover() {}
function go(n) {}
-- css_angles_size.tlide --
/* target의 크기(w, h)와 angles = css(그라데이션, 그림자 각도). pptx/angles_css와 같은 문서다 */
#include <std/stddef>

slide {
    put shape {
        kind = rect; x = 20px; y = 20px; width = 200px; height = 100px;
        fill = linear(0, hex(F00), hex(00F));
        shadow = hex(000000); shadow_distance = 6px; shadow_angle = 90;
    }
    put shape { kind = rect; x = 240px; y = 20px; width = 200px; height = 100px; fill = linear(90, hex(F00), hex(00F)); }
    put text_box { text = "퍼센트 위치"; x = 10%; y = 80%; width = 50%; height = 10%; }
}

target out { path = "css_angles_size.html"; type = html; angles = css; width = 800px; height = 450px; }
