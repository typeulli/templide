-- include_errors/main.tlide --
/* include 오류. 못 찾는 패키지는 <...>에 칠하고, include한 파일의 오류는 그 파일을 include한 줄에도 첫 오류 하나로 알린다
   (_broken은 문법 오류, _nested는 자기가 include한 패키지를 못 찾는 오류) */
#include <std/stddef>
#include <std/nope>
#include "_broken"
#include "_nested"
slide { }
