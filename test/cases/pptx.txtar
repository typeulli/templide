-- shapes_fill_line.tlide --
/* 도형의 채우기(단색, 투명도, 그라데이션, 무늬), 선, 효과(그림자, 빛, 부드러운 가장자리), 회전과 뒤집기, 조절점 */
#include <std/stddef>

slide {
    put shape {
        kind = rect; x = 20px; y = 20px; width = 120px; height = 80px;
        fill = hex(3498DB);
        line_color = hex(2C3E50); line_width = 3px; line_dash = dash; line_cap = round; line_join = bevel;
    }
    put shape { kind = ellipse; x = 160px; y = 20px; width = 120px; height = 80px; fill = rgba(231, 76, 60, 0.5); }
    put shape { kind = rect; x = 300px; y = 20px; width = 120px; height = 80px; fill = linear(90, hex(F00), hex(00F)); }
    put shape { kind = rect; x = 440px; y = 20px; width = 120px; height = 80px; fill = linear(0, hex(F00) 20%, hex(0F0) 50%, hex(00F)); }
    put shape { kind = rect; x = 580px; y = 20px; width = 120px; height = 80px; fill = radial(hex(FFF), hex(000)); }
    put shape { kind = rect; x = 720px; y = 20px; width = 120px; height = 80px; fill = pattern(diagonal_cross, hex(000), hex(FFF)); }
    put shape { kind = roundRect; x = 20px; y = 140px; width = 120px; height = 80px; radius = 20px; fill = hex(1ABC9C); }
    put shape { kind = rightArrow; x = 160px; y = 140px; width = 120px; height = 80px; fill = hex(9B59B6); adj1 = 0.3; adj2 = 0.4; }
    put shape {
        kind = star5; x = 300px; y = 140px; width = 100px; height = 100px; fill = hex(F1C40F);
        shadow = rgba(0, 0, 0, 0.4); shadow_blur = 6px; shadow_distance = 4px; shadow_angle = 45;
        glow = hex(E67E22); glow_size = 8px;
    }
    put shape { kind = triangle; x = 440px; y = 140px; width = 100px; height = 80px; fill = hex(2ECC71); rotation = 30; flip = vertical; opacity = 0.7; }
    put shape { kind = rect; x = 580px; y = 140px; width = 100px; height = 80px; fill = hex(34495E); soft_edge = 6px; inner_shadow = hex(000); inner_shadow_blur = 4px; }
}

target deck { path = "shapes_fill_line.pptx"; type = pptx; }
-- shapes_fill_line.xml --
