-- lines_connectors_freeform.tlide --
/* 선(화살표), 연결선(개체를 옮기면 따라가도록 연결점 번호를 쓴다), freeform(SVG path를 custGeom으로) */
#include <std/stddef>

slide {
    put line { x1 = 20px; y1 = 20px; x2 = 220px; y2 = 20px; end_arrow = triangle; line_color = hex(333333); line_width = 3px; }
    put line { x1 = 20px; y1 = 60px; x2 = 220px; y2 = 100px; start_arrow = oval; end_arrow = stealth; line_dash = dot; }
    put line { x1 = 220px; y1 = 140px; x2 = 20px; y2 = 120px; }
    put shape as left { kind = rect; x = 20px; y = 200px; width = 100px; height = 60px; }
    put shape as right { kind = ellipse; x = 300px; y = 280px; width = 100px; height = 60px; }
    put connector { from = left; to = right; kind = elbow; end_arrow = arrow; }
    put connector { from = left; to = right; kind = straight; from_side = bottom; to_side = left; }
    put connector { from = right; to = left; kind = curved; }
    put freeform { x = 500px; y = 40px; path = "M 0 0 L 100 0 L 50 80 Z"; fill = hex(9B59B6); }
    put freeform { x = 500px; y = 160px; path = "M 0 40 C 20 0 60 0 80 40 S 140 80 160 40 H 200 V 100 Q 100 60 0 100 Z"; line_color = hex(333333); line_width = 2px; }
}

target deck { path = "lines_connectors_freeform.pptx"; type = pptx; }
