-- links_actions.parts --
ppt/slides/*.xml
ppt/slides/_rels/*.rels
-- lists.tlide --
/* 목록: 기호(buChar), 번호(buAutoNum), 단계별 들여쓰기(marL, indent), 번호 모양과 시작 번호, 사용자 기호 */
#include <std/stddef>

style roman { list-style = upper_roman; list-start = 3; }
style marker { list-marker = "▶"; list-marker-color = hex(C0392B); }

slide {
    put text_box {
        text = bullets ["첫째", "둘째", numbers ["안쪽 번호 1", "안쪽 번호 2", dashes ["더 안쪽 줄표"]], "셋째"];
        x = 40px; y = 30px; width = 500px; height = 200px;
    }
    put text_box {
        text = roman numbers ["로마 숫자", "셋부터"];
        x = 40px; y = 250px; width = 500px; height = 80px;
    }
    put text_box {
        text = marker bullets ["사용자 기호", "빨간 기호"] "목록 뒤의 글";
        x = 40px; y = 350px; width = 500px; height = 120px;
    }
}

target deck { path = "lists.pptx"; type = pptx; }
-- lists.xml --
