-- image_basic/main.tlide --
/* 그림(pic.png는 4x2px). fit, 자르기(crop), 도형 모양(kind), 이름 붙인 image와 배경 그림. 같은 파일은 ppt/media에 한 번만 들어간다 */
#include <std/stddef>

image pic = file("pic.png");

slide {
    background = pic;
    put image { data = pic; x = 20px; y = 20px; width = 200px; height = 200px; }
    put image { data = pic; x = 240px; y = 20px; width = 200px; height = 200px; fit = contain; }
    put image { data = file("pic.png"); x = 460px; y = 20px; width = 200px; height = 200px; fit = cover; }
    put image { data = "pic.png"; x = 680px; y = 20px; width = 200px; height = 100px; crop_left = 25%; crop_right = 25%; kind = ellipse; alt = "그림 설명"; }
}

target out { path = "image_basic.pptx"; type = pptx; }
-- image_basic/main.xml --
