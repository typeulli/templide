      </p:sp>
    </p:spTree>
  </p:cSld>
  <p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr>
</p:sld>
-- animations.tlide --
/* 애니메이션은 p:timing의 재생 순서(클릭, 이전과 함께, 이전 다음에)로 나온다. 개체에는 spid가 붙고 order가 차례를 바꾼다 */
#include <std/stddef>

slide {
    put text_box as a { text = "A"; x = 20px; y = 20px; width = 200px; height = 40px; }
    put text_box as b { text = "B"; x = 20px; y = 80px; width = 200px; height = 40px; }
    put shape as c {
        kind = ellipse; x = 20px; y = 140px; width = 60px; height = 60px;
        animate enter zoom.in 1s with_previous;
    }

    animate a enter fade 0.5s;
    animate a enter fly.left 1s with_previous delay 0.2s;
    animate b emphasis spin after_previous;
    animate b exit wipe.up 400ms on_click;
    animate b move path "M 0 0 L 100 0 L 100 100";
    animate c move circle 2s;
    animate c emphasis growShrink order 1;
}

target out { path = "animations.pptx"; type = pptx; }
