        <p:txBody>
          <a:bodyPr wrap="square" rtlCol="0" anchor="ctr"><a:noAutofit/></a:bodyPr>
          <a:lstStyle/>
          <a:p>
            <a:pPr algn="l"><a:buNone/></a:pPr>
            <a:r>
              <a:rPr sz="3200" b="1"><a:solidFill><a:srgbClr val="C0392B"/></a:solidFill></a:rPr>
              <a:t>제목</a:t>
            </a:r>
            <a:r>
              <a:rPr sz="3200" b="1"><a:solidFill><a:srgbClr val="C0392B"/></a:solidFill></a:rPr>
