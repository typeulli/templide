-- table_basic.tlide --
/* 표 하나. a:tbl의 격자(gridCol), 행 높이, 병합(gridSpan, rowSpan, hMerge, vMerge), 칸 서식(tcPr의 여백, 정렬, 네 변의 선, 채우기)과
   머리글, 줄무늬 칠하기가 칸마다 풀려서 나온다. 가려진 칸은 글이 비어 있다 */
#include <std/stddef>
#include <std/styles>

slide {
    put table {
        x = 80px; y = 120px; width = 1000px; height = 300px;
        cells = [
            ["이름", "1분기", "2분기", "비고"],
            ["서울", "10", bold "20", "긴 글이 들어가면 행이 늘어난다"],
            ["부산", "5", "7", ""],
            ["합계", "", "", ""]
        ];
        col_widths = [300px, 200px, 200px, 300px];
        header_rows = 1;
        header_cols = 1;
        banded_rows = true;
        line_color = hex(808080);
        padding = 10px;
        align = center;
        cell(4, 2) { col_span = 2; fill = hex(FFE699); anchor = bottom; }
        cell(2, 4) { row_span = 2; fill = hex(C6E0B4); line_color = hex(FF0000); line_width = 3px; align = left; }
        cell(1, 1) { line_color_bottom = hex(0000FF); line_width_bottom = 4px; padding_left = 24px; }
    }
}

target deck { path = "table.pptx"; type = pptx; }
-- table_basic.xml --
