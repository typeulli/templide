-- slide_size.tlide --
/* target의 width와 height는 슬라이드 크기(sldSz)가 되고, %는 그 크기에 대한 비율로 풀린다. 단위는 px, in, mm를 섞어 써도 된다 */
#include <std/stddef>

slide {
    put shape { kind = rect; x = 10%; y = 10%; width = 50%; height = 50%; fill = hex(3498DB); }
    put text_box { text = "크기 비율"; x = 0px; y = 90%; width = 100%; height = 10%; }
}

target out { path = "slide_size.pptx"; type = pptx; width = 10in; height = 150mm + 1in; }
-- slide_size.xml --
