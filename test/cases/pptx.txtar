-- links_actions.tlide --
/* link와 action. 슬라이드 이동과 주소는 hlinkClick(주소는 slide의 관계 파일에 외부 관계로), 파일과 프로그램과 매크로는 ppaction으로 나온다.
   run(...)은 pptx에서 무시된다 (error/warning_run_in_pptx에서 경고를 본다) */
#include <std/stddef>

slide {
    put text_box { text = "주소"; x = 10px; y = 10px; width = 100px; height = 30px; link = "https://example.com/a?b=1&c=2"; }
    put text_box { text = "슬라이드 2"; x = 10px; y = 50px; width = 100px; height = 30px; link = slide(2); }
    put text_box { text = "다음"; x = 10px; y = 90px; width = 100px; height = 30px; link = next_slide; }
    put text_box { text = "끝"; x = 10px; y = 130px; width = 100px; height = 30px; link = end_show; }
    put shape { kind = rect; x = 150px; y = 10px; width = 100px; height = 30px; action = action_file("docs/report.pdf"); }
    put shape { kind = rect; x = 150px; y = 50px; width = 100px; height = 30px; action = program("tools/app.exe"); action_highlight = true; }
    put shape { kind = rect; x = 150px; y = 90px; width = 100px; height = 30px; action = macro("Module1.Hello"); }
    put shape { kind = rect; x = 150px; y = 130px; width = 100px; height = 30px; hover_action = slide(2); }
    put text_box {
        text = "앞 " link("https://example.org") "링크 글자" " 뒤" ;
        x = 300px; y = 10px; width = 300px; height = 30px;
    }
    put text_box {
        text = link(slide(2)) "슬라이드 링크" ;
        x = 300px; y = 50px; width = 300px; height = 30px;
    }
}

slide {
    put text_box { text = "둘째"; x = 10px; y = 10px; width = 100px; height = 30px; link = first_slide; }
}

target out { path = "links_actions.pptx"; type = pptx; }
-- links_actions.xml --
=== ppt/slides/slide1.xml ===
<p:sld
    xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"
    xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main">
  <p:cSld>
    <p:spTree>
      <p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr>
      <p:grpSpPr>
        <a:xfrm>
          <a:off x="0" y="0"/>
          <a:ext cx="0" cy="0"/>
          <a:chOff x="0" y="0"/>
          <a:chExt cx="0" cy="0"/>
        </a:xfrm>
      </p:grpSpPr>
      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="2" name="TextBox 1"><a:hlinkClick r:id="rId2"/></p:cNvPr>
          <p:cNvSpPr txBox="1"/>
          <p:nvPr/>
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm><a:off x="95250" y="95250"/><a:ext cx="952500" cy="285750"/></a:xfrm>
          <a:prstGeom prst="rect"><a:avLst/></a:prstGeom>
          <a:noFill/>
        </p:spPr>
        <p:txBody>
