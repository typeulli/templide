          </a:p>
          <a:p>
            <a:pPr algn="l" lvl="1" marL="685800" indent="-342900">
              <a:buAutoNum type="arabicPeriod"/>
            </a:pPr>
            <a:r><a:t>안쪽 번호 2</a:t></a:r>
          </a:p>
          <a:p>
            <a:pPr algn="l" lvl="2" marL="1028700" indent="-342900">
