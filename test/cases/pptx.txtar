                <c:ptCount val="3"/>
                <c:pt idx="0"><c:v>가</c:v></c:pt>
                <c:pt idx="1"><c:v>나</c:v></c:pt>
                <c:pt idx="2"><c:v>다</c:v></c:pt>
              </c:strCache>
            </c:strRef>
          </c:cat>
          <c:val>
            <c:numRef>
              <c:f>Sheet1!$B$2:$B$4</c:f>
              <c:numCache>
                <c:formatCode>General</c:formatCode>
                <c:ptCount val="3"/>
                <c:pt idx="0"><c:v>50</c:v></c:pt>
                <c:pt idx="1"><c:v>30</c:v></c:pt>
                <c:pt idx="2"><c:v>20</c:v></c:pt>
              </c:numCache>
            </c:numRef>
          </c:val>
        </c:ser>
        <c:firstSliceAng val="0"/>
