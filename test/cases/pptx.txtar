-- master_layouts.parts --
ppt/slideLayouts/*.xml
ppt/slides/*.xml
ppt/slides/_rels/*.rels
-- notes_sections_reviews.tlide --
/* 발표자 메모(notesSlide), 구역(sectionLst), 숨긴 슬라이드(show="0"), 검토 메모(comments와 authors, 시각은 $TIMESTAMP로 바꿔 비교한다) */
#include <std/stddef>

section "시작";

slide {
    put text_box { text = "첫 슬라이드"; x = 10px; y = 10px; width = 200px; height = 30px; }
    comment "발표자 메모 첫 문단";
    comment "둘째 문단" " 이어 붙인 글";
}

slide {
    hidden = true;
}

section "본문";

slide {
    review { text = "검토 의견\n둘째 줄"; author = "김"; x = 10px; y = 20px; }
    review { text = "위치만 지정"; x = 50%; y = 25%; }
    review { text = "다른 사람"; author = "이"; }
}

slide { }

target out { path = "notes_sections_reviews.pptx"; type = pptx; }
-- notes_sections_reviews.xml --
