-- groups_names.tlide --
/* group은 p:grpSp로, put ... as 이름은 개체 이름(cNvPr name)으로 나온다. 이름 없는 개체는 종류와 번호로 이름이 붙는다 */
#include <std/stddef>

template pair {
    var text a;
    var text b;
    put text_box { text = a; x = 0px; y = 0px; width = 100px; height = 30px; }
    put text_box { text = b; x = 0px; y = 40px; width = 100px; height = 30px; }
}

slide {
    put text_box as heading { text = "이름 있는 글상자"; x = 20px; y = 20px; width = 200px; height = 30px; }
    put shape { kind = ellipse; x = 240px; y = 20px; width = 40px; height = 30px; }
    group as cluster {
        put shape { kind = rect; x = 20px; y = 80px; width = 50px; height = 50px; }
        put shape { kind = rect; x = 80px; y = 80px; width = 50px; height = 50px; }
        group {
            put shape { kind = ellipse; x = 140px; y = 80px; width = 50px; height = 50px; }
        }
    }
    put pair as couple { a = "묶인 템플릿 1"; b = "묶인 템플릿 2"; }
    put pair { a = "이름 없는 템플릿 1"; b = "이름 없는 템플릿 2"; }
}

target deck { path = "groups_names.pptx"; type = pptx; }
-- groups_names.xml --
=== ppt/slides/slide1.xml ===
<p:sld
    xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"
    xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"
