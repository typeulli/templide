-- colors.tlide --
/* 색 표현이 DrawingML에서 어떻게 나오는지. RGB는 srgbClr(알파가 있으면 alpha), 테마 색은 schemeClr */
#include <std/stddef>

slide {
    put shape { kind = rect; x = 0px; y = 0px; width = 50px; height = 50px; fill = hex(FF8800); }
    put shape { kind = rect; x = 60px; y = 0px; width = 50px; height = 50px; fill = rgba(255, 136, 0, 0.5); }
    put shape { kind = rect; x = 120px; y = 0px; width = 50px; height = 50px; fill = hsl(32deg, 100%, 50%); }
    put shape { kind = rect; x = 180px; y = 0px; width = 50px; height = 50px; fill = oklch(75%, 0.16, 65deg); }
    put shape { kind = rect; x = 240px; y = 0px; width = 50px; height = 50px; fill = theme.accent1; }
    put shape { kind = rect; x = 300px; y = 0px; width = 50px; height = 50px; fill = theme.dark2; line_color = theme.accent3; line_width = 2px; }
    put text_box {
        text = style(color = theme.hyperlink) "테마색 글자" style(color = rgba(0, 0, 0, 0.5), highlight = hex(FF0)) " 반투명 강조";
        x = 0px; y = 80px; width = 400px; height = 40px;
    }
}

target deck { path = "colors.pptx"; type = pptx; }
