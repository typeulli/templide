-- master_layouts.tlide --
/* master의 case는 slideLayout이 되고, placeholder는 개체 틀(p:ph)이 된다. slide의 title, subtitle, body는 그 개체 틀을 채우고,
   layout의 background와 일반 개체는 layout에 들어간다. layout을 안 쓴 slide는 빈 layout을 쓴다 */
#include <std/stddef>

master deck {
    case cover {
        background = hex(F5F5F5);
        put placeholder { role = title; x = 100px; y = 200px; width = 1080px; height = 120px; text = "제목을 입력"; anchor = middle; }
        put placeholder { role = subtitle; x = 100px; y = 340px; width = 1080px; height = 60px; }
        put shape { kind = rect; x = 0px; y = 700px; width = 1280px; height = 20px; fill = hex(2E86AB); }
    }
    case content {
        put placeholder { role = title; x = 60px; y = 30px; width = 1160px; height = 80px; }
        put placeholder { role = body; x = 60px; y = 130px; width = 1160px; height = 520px; }
        put text_box { text = @slide.number; x = 1180px; y = 680px; width = 60px; height = 30px; }
    }
}

slide {
    layout = deck.cover;
    title = "표지 제목";
    subtitle = style(color = hex(777777)) "부제";
}

slide {
    layout = deck.content;
    title = "본문 제목";
    body = bullets ["첫째", "둘째"];
}

slide {
    put text_box { text = "layout 없는 슬라이드"; x = 10px; y = 10px; width = 300px; height = 40px; }
}

target out { path = "master_layouts.pptx"; type = pptx; }
