            </a:pPr>
            <a:r><a:t>더 안쪽 줄표</a:t></a:r>
          </a:p>
          <a:p>
            <a:pPr algn="l" lvl="0" marL="342900" indent="-342900">
              <a:buFont typeface="Arial"/>
              <a:buChar char="•"/>
            </a:pPr>
            <a:r><a:t>셋째</a:t></a:r>
          </a:p>
        </p:txBody>
