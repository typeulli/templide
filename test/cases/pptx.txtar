    </p:bldLst>
  </p:timing>
</p:sld>
-- boilerplate.tlide --
/* 문서가 어떻든 같은 꼴로 나오는 패키지 부분(마스터, 빈 layout, 테마, 속성 파일, 관계 파일)을 이 케이스 하나에서 본다.
   다른 케이스가 바깥의 바뀜에 흔들리지 않게 그 부분들은 여기에만 둔다 */
#include <std/stddef>

slide {
    put text_box { text = "내용"; x = 10px; y = 10px; width = 100px; height = 30px; }
}

target deck { path = "boilerplate.pptx"; type = pptx; title = "문서 제목"; author = "작성자"; }
-- boilerplate.xml --
=== [Content_Types].xml ===
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
