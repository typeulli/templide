                <c:pt idx="0"><c:v>월</c:v></c:pt>
                <c:pt idx="1"><c:v>화</c:v></c:pt>
                <c:pt idx="2"><c:v>수</c:v></c:pt>
              </c:strCache>
            </c:strRef>
          </c:cat>
          <c:val>
            <c:numRef>
              <c:f>Sheet1!$B$2:$B$4</c:f>
              <c:numCache>
                <c:formatCode>General</c:formatCode>
