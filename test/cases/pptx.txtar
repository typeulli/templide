-- fields.tlide --
/* @slide.number는 slidenum 필드, @date는 datetime1 필드(글자는 오늘 날짜라 $DATE로 바꿔 비교한다)로 나온다. 필드 id는 순서대로 붙는다 */
#include <std/stddef>

slide {
    put text_box { text = "쪽 " @slide.number " / 날짜 " @date; x = 10px; y = 10px; width = 400px; height = 30px; }
}
slide {
    put text_box { text = style(font-weight = bold) @slide.number; x = 10px; y = 10px; width = 100px; height = 30px; }
}

target out { path = "fields.pptx"; type = pptx; }
