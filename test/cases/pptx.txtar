-- charts_kinds.parts --
# 차트 파트와 슬라이드가 차트를 가리키는 곳. 통합 문서는 zip이라 비교하지 않는다
ppt/slides/slide*.xml
ppt/slides/_rels/*.rels
ppt/charts/chart*.xml
ppt/charts/_rels/*.rels
-- math_equations.tlide --
/* 수식은 PowerPoint 수식(OMML)으로 바뀌어 글상자 하나에 들어간다 (mc:AlternateContent: 수식을 모르는 프로그램에는 LaTeX 원문을 보인다) */
#include <std/stddef>

slide {
    put math { latex = "E = mc^2"; x = 0px; y = 0px; width = 600px; height = 80px; font_size = 40px; }
    put math { latex = "\\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}"; x = 0px; y = 100px; width = 600px; height = 120px; align = left; anchor = top; text_color = hex(2E86AB); }
    put math { latex = "\\sum_{i=1}^{n} i^2 \\leq \\int_0^1 f(x)\\,dx"; x = 0px; y = 240px; width = 600px; height = 100px; }
    put math { latex = "\\lim_{x \\to 0} \\frac{\\sin x}{x} = 1"; x = 0px; y = 360px; width = 600px; height = 100px; align = right; anchor = bottom; }
    put math { latex = "\\left( \\frac{a}{b} \\right)^{n} \\geq \\alpha \\cdot \\vec{v}"; x = 0px; y = 480px; width = 600px; height = 100px; }
    put math { latex = "A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}, \\mathbb{R}^3, \\text{속도}"; x = 0px; y = 600px; width = 600px; height = 100px; }
}

target deck { path = "deck.pptx"; type = pptx; }
-- math_equations.xml --
