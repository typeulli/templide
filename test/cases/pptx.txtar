-- lengths_units.tlide --
/* 위치와 크기의 단위. 모두 EMU(1px = 9525)로 바뀌고 %는 슬라이드 크기(여기서는 기본 1280px x 720px)에 대한 비율이다 */
#include <std/stddef>

slide {
    put shape { kind = rect; x = 100px; y = 50px; width = 200px; height = 100px; }
    put shape { kind = rect; x = 12pt; y = 12pt; width = 72pt; height = 36pt; }
    put shape { kind = rect; x = 1in; y = 2in; width = 2in; height = 1in; }
    put shape { kind = rect; x = 1cm; y = 5cm; width = 5cm; height = 2cm; }
    put shape { kind = rect; x = 10mm; y = 100mm; width = 50mm; height = 20mm; }
    put shape { kind = rect; x = 25%; y = 50%; width = 50%; height = 25%; }
    put shape { kind = rect; x = 50% - 100px; y = 90%; width = 200px; height = 5%; }
    put shape { kind = rect; x = 10; y = 600; width = 100; height = 50; }
    put shape { kind = rect; x = -50px; y = -20px; width = 100px; height = 60px; }
}

target deck { path = "lengths_units.pptx"; type = pptx; }
