-- text_basic.tlide --
/* text_box 하나. 위치와 크기는 EMU(1px = 9525)로, 글꼴 크기는 1/100pt로, 문단 속성은 a:pPr로 나온다 */
#include <std/stddef>

style big { font-size = 32pt; font-weight = bold; color = hex(C0392B); }
style note { font-size = 12pt; font-style = italic; text-decoration = underline; }
style centered { text-align = center; space-before = 6pt; line-height = 1.5; }

slide {
    put text_box {
        text = big "제목" " 굵게 큰 글자";
        x = 40px; y = 30px; width = 600px; height = 80px;
        anchor = middle;
    }
    put text_box {
        text = centered note "가운데 정렬한 기울임 글";
        x = 40px; y = 140px; width = 600px; height = 60px;
    }
    put text_box {
        text = "첫 줄\n같은 문단의 둘째 줄" "\n" "마지막";
        x = 40px; y = 220px; width = 600px; height = 80px;
        anchor = bottom;
    }
}

target deck { path = "text_basic.pptx"; type = pptx; }
-- text_basic.xml --
=== ppt/slides/slide1.xml ===
<p:sld
    xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"
    xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"
