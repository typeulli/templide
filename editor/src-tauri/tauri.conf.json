{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "templide",
  "version": "1.2.1",
  "identifier": "com.templide.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "templide",
        "create": false,
        "decorations": false,
        "visible": false,
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "publisher": "typeulli",
    "copyright": "Copyright (c) 2026 typeulli",
    "icon": ["../../assets/icon/templide.ico", "../../assets/icon/templide.icns", "../../assets/icon/templide.png"]
  }
}
