{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "templide",
  "version": "1.0.0",
  "identifier": "com.templide.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "templide",
        "decorations": false,
        "visible": false,
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../assets/icon/templide.ico"]
  }
}
