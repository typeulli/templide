{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../cmake-build-release/templide.exe": "templide.exe",
      "../../cmake-build-release/libwinpthread-1.dll": "libwinpthread-1.dll",
      "../../packages/": "packages/",
      "../../libs/": "libs/",
      "conpty/x64/conpty.dll": "conpty.dll",
      "conpty/x64/OpenConsole.exe": "OpenConsole.exe"
    },
    "fileAssociations": [
      {
        "ext": ["tlide"],
        "name": "templide",
        "description": "templide 슬라이드",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../../assets/icon/templide.ico",
        "uninstallerIcon": "../../assets/icon/templide.ico",
        "headerImage": "../../assets/installer/header.bmp",
        "sidebarImage": "../../assets/installer/sidebar.bmp",
        "installMode": "both",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
