{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "category": "Productivity",
    "licenseFile": "../../LICENSE",
    "fileAssociations": [
      {
        "ext": ["tlide"],
        "name": "templide",
        "description": "Templide Slide",
        "role": "Editor"
      },
      {
        "ext": ["tasset"],
        "name": "templide-asset",
        "description": "Templide Asset",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../../assets/icon/templide.ico",
        "uninstallerIcon": "../../assets/icon/templide.ico",
        "headerImage": "../../assets/installer/header.bmp",
        "sidebarImage": "../../assets/installer/sidebar.bmp",
        "installMode": "both",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
