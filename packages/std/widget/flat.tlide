/*
플랫 디자인 (flat design). 그림자와 테두리 없이 선명한 단색 면만 쓴다.

사용법
    #include <std/widget/flat>
    slide {
        put flat_card { title = "제목"; content = "내용"; x = 100px; y = 100px; width = 400px; height = 240px; }
        put flat_button { text = "시작"; x = 100px; y = 380px; width = 200px; height = 56px; }
    }
*/
#include <std/stddef>

style flat_title {
    color = hex(2C3E50);
    font-size = 20pt;
    font-weight = bold;
}
style flat_body {
    color = hex(34495E);
    font-size = 14pt;
}
style flat_label {
    color = hex(FFF);
    font-size = 16pt;
    font-weight = bold;
}

/* 모든 플랫 위젯의 바탕. radius는 모서리 반지름이다 */
template flat_surface {
    var int x;
    var int y;
    var int width;
    var int height;
    var int radius;
    var text text = "";
    var color color = hex(3498DB);
    put shape {
        kind = roundRect;
        x = x; y = y; width = width; height = height; radius = radius;
        fill = color;
        line_color = rgba(0, 0, 0, 0);
        text = flat_label text;
    }
}

template flat_rect {
    var int x;
    var int y;
    var int width;
    var int height;
    var color color = hex(3498DB);
    put flat_surface { x = x; y = y; width = width; height = height; radius = 0px; color = color; }
}

template flat_round_rect {
    var int x;
    var int y;
    var int width;
    var int height;
    var int radius = 12px;
    var color color = hex(3498DB);
    put flat_surface { x = x; y = y; width = width; height = height; radius = radius; color = color; }
}

/* size는 지름 */
template flat_circle {
    var int x;
    var int y;
    var int size;
    var color color = hex(3498DB);
    put flat_surface { x = x; y = y; width = size; height = size; radius = size; color = color; }
}

/* 짧은 변의 양 끝이 반원인 알약 모양 */
template flat_pill {
    var int x;
    var int y;
    var int width;
    var int height;
    var color color = hex(3498DB);
    put flat_surface { x = x; y = y; width = width; height = height; radius = width + height; color = color; }
}

template flat_button {
    var text text;
    var int x;
    var int y;
    var int width;
    var int height;
    var int radius = 6px;
    var color color = hex(3498DB);
    put flat_surface { x = x; y = y; width = width; height = height; radius = radius; text = text; color = color; }
}

/* 위쪽에 제목, 그 아래에 내용이 들어가는 카드. 안쪽 여백은 24px */
template flat_card {
    var text title;
    var text content = "";
    var int x;
    var int y;
    var int width;
    var int height;
    var int radius = 8px;
    var color color = hex(ECF0F1);
    put flat_surface { x = x; y = y; width = width; height = height; radius = radius; color = color; }
    put text_box {
        text = flat_title title;
        x = x + 24px; y = y + 20px; width = width - 48px; height = 40px;
        anchor = middle;
    }
    put text_box {
        text = flat_body content;
        x = x + 24px; y = y + 64px; width = width - 48px; height = height - 84px;
    }
}
