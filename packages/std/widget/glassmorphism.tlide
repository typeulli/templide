/*
글래스모피즘 (glassmorphism). 뒤 배경이 흐리게 비치는 반투명한 유리판.

사용법
    #include <std/widget/glassmorphism>
    slide {
        background = image("bg.jpg");
        put glass_card { title = "제목"; content = "내용"; x = 100px; y = 100px; width = 400px; height = 240px; }
        put glass_button { text = "시작"; x = 100px; y = 380px; width = 200px; height = 64px; }
    }

뒤에 색이 많은 배경(그림이나 linear 그라데이션)이 있어야 유리처럼 보인다.
blur는 밑에 까는 backdrop의 흐림이라서 slide나 layout의 배경만 흐려지고, 그 위의 다른 도형은 흐려지지 않는다.
tint에서 tint_end로 왼쪽 위에서 오른쪽 아래로 옅어지는 흰 막을 씌운다.
*/
#include <std/stddef>

style glass_title {
    color = hex(FFF);
    font-size = 20pt;
    font-weight = bold;
}
style glass_body {
    color = rgba(255, 255, 255, 0.85);
    font-size = 14pt;
}
style glass_label {
    color = hex(FFF);
    font-size = 16pt;
    font-weight = bold;
}

/* 모든 글래스모피즘 위젯의 바탕. radius는 모서리 반지름이다. 흐린 배경 조각(그림자도 여기에) 위에 반투명한 막을 겹친다 */
template glass_surface {
    var int x;
    var int y;
    var int width;
    var int height;
    var int radius;
    var text text = "";
    var int blur = 16px;
    var color tint = rgba(255, 255, 255, 0.35);
    var color tint_end = rgba(255, 255, 255, 0.1);
    var color border = rgba(255, 255, 255, 0.5);
    var color shade = rgba(0, 0, 0, 0.25);
    put backdrop {
        kind = roundRect;
        x = x; y = y; width = width; height = height; radius = radius;
        blur = blur;
        shadow = shade; shadow_blur = 32px; shadow_distance = 8px; shadow_angle = 90;
    }
    put shape {
        kind = roundRect;
        x = x; y = y; width = width; height = height; radius = radius;
        fill = linear(45, tint, tint_end);
        line_color = border; line_width = 1px;
        text = glass_label text;
    }
}

template glass_rect {
    var int x;
    var int y;
    var int width;
    var int height;
    var int blur = 16px;
    var color tint = rgba(255, 255, 255, 0.35);
    var color tint_end = rgba(255, 255, 255, 0.1);
    var color border = rgba(255, 255, 255, 0.5);
    var color shade = rgba(0, 0, 0, 0.25);
    put glass_surface {
        x = x; y = y; width = width; height = height; radius = 0px;
        blur = blur; tint = tint; tint_end = tint_end; border = border; shade = shade;
    }
}

template glass_round_rect {
    var int x;
    var int y;
    var int width;
    var int height;
    var int radius = 24px;
    var int blur = 16px;
    var color tint = rgba(255, 255, 255, 0.35);
    var color tint_end = rgba(255, 255, 255, 0.1);
    var color border = rgba(255, 255, 255, 0.5);
    var color shade = rgba(0, 0, 0, 0.25);
    put glass_surface {
        x = x; y = y; width = width; height = height; radius = radius;
        blur = blur; tint = tint; tint_end = tint_end; border = border; shade = shade;
    }
}

/* size는 지름 */
template glass_circle {
    var int x;
    var int y;
    var int size;
    var int blur = 16px;
    var color tint = rgba(255, 255, 255, 0.35);
    var color tint_end = rgba(255, 255, 255, 0.1);
    var color border = rgba(255, 255, 255, 0.5);
    var color shade = rgba(0, 0, 0, 0.25);
    put glass_surface {
        x = x; y = y; width = size; height = size; radius = size;
        blur = blur; tint = tint; tint_end = tint_end; border = border; shade = shade;
    }
}

/* 짧은 변의 양 끝이 반원인 알약 모양 */
template glass_pill {
    var int x;
    var int y;
    var int width;
    var int height;
    var int blur = 16px;
    var color tint = rgba(255, 255, 255, 0.35);
    var color tint_end = rgba(255, 255, 255, 0.1);
    var color border = rgba(255, 255, 255, 0.5);
    var color shade = rgba(0, 0, 0, 0.25);
    put glass_surface {
        x = x; y = y; width = width; height = height; radius = width + height;
        blur = blur; tint = tint; tint_end = tint_end; border = border; shade = shade;
    }
}

template glass_button {
    var text text;
    var int x;
    var int y;
    var int width;
    var int height;
    var int radius = 16px;
    var int blur = 16px;
    var color tint = rgba(255, 255, 255, 0.35);
    var color tint_end = rgba(255, 255, 255, 0.1);
    var color border = rgba(255, 255, 255, 0.5);
    var color shade = rgba(0, 0, 0, 0.25);
    put glass_surface {
        x = x; y = y; width = width; height = height; radius = radius; text = text;
        blur = blur; tint = tint; tint_end = tint_end; border = border; shade = shade;
    }
}

/* 위쪽에 제목, 그 아래에 내용이 들어가는 카드. 안쪽 여백은 24px */
template glass_card {
    var text title;
    var text content = "";
    var int x;
    var int y;
    var int width;
    var int height;
    var int radius = 24px;
    var int blur = 16px;
    var color tint = rgba(255, 255, 255, 0.35);
    var color tint_end = rgba(255, 255, 255, 0.1);
    var color border = rgba(255, 255, 255, 0.5);
    var color shade = rgba(0, 0, 0, 0.25);
    put glass_surface {
        x = x; y = y; width = width; height = height; radius = radius;
        blur = blur; tint = tint; tint_end = tint_end; border = border; shade = shade;
    }
    put text_box {
        text = glass_title title;
        x = x + 24px; y = y + 20px; width = width - 48px; height = 40px;
        anchor = middle;
    }
    put text_box {
        text = glass_body content;
        x = x + 24px; y = y + 64px; width = width - 48px; height = height - 84px;
    }
}
