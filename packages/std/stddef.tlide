/* 상자 안에서 글자를 세로로 놓는 위치 */
enum text_anchor { top, middle, bottom }

object text_box {
    var text text;
    var int x;
    var int y;
    var int width;
    var int height;
    var text_anchor anchor = top;
}

/* stretch는 상자에 맞게 늘리고, cover는 비율을 지키며 상자를 채우고 넘치는 쪽을 자르고, contain은 비율을 지키며 상자 안에 다 보이게 한다 */
enum image_fit { stretch, cover, contain }

/* data는 그림 파일로 file("경로"), asset("이름"), image로 이름 붙인 값, 문자열 경로를 쓴다.
   crop_*은 그림에서 잘라 낼 부분으로 %는 그림 크기에 대한 비율이다. kind로 그림을 도형 모양으로 자른다 */
object image {
    var image data;
    var int x;
    var int y;
    var int width;
    var int height;
    var image_fit fit = stretch;
    var float crop_left = 0%;
    var float crop_top = 0%;
    var float crop_right = 0%;
    var float crop_bottom = 0%;
    var shape_kind kind = rect;
}

/* PowerPoint의 도형 종류 (preset geometry) */
enum shape_kind {
    accentBorderCallout1, accentBorderCallout2, accentBorderCallout3, accentCallout1, accentCallout2,
    accentCallout3, actionButtonBackPrevious, actionButtonBeginning, actionButtonBlank, actionButtonDocument,
    actionButtonEnd, actionButtonForwardNext, actionButtonHelp, actionButtonHome, actionButtonInformation,
    actionButtonMovie, actionButtonReturn, actionButtonSound, arc, bentArrow, bentConnector2, bentConnector3,
    bentConnector4, bentConnector5, bentUpArrow, bevel, blockArc, borderCallout1, borderCallout2,
    borderCallout3, bracePair, bracketPair, callout1, callout2, callout3, can, chartPlus, chartStar, chartX,
    chevron, chord, circularArrow, cloud, cloudCallout, corner, cornerTabs, cube, curvedConnector2,
    curvedConnector3, curvedConnector4, curvedConnector5, curvedDownArrow, curvedLeftArrow, curvedRightArrow,
    curvedUpArrow, decagon, diagStripe, diamond, dodecagon, donut, doubleWave, downArrow, downArrowCallout,
    ellipse, ellipseRibbon, ellipseRibbon2, flowChartAlternateProcess, flowChartCollate, flowChartConnector,
    flowChartDecision, flowChartDelay, flowChartDisplay, flowChartDocument, flowChartExtract,
    flowChartInputOutput, flowChartInternalStorage, flowChartMagneticDisk, flowChartMagneticDrum,
    flowChartMagneticTape, flowChartManualInput, flowChartManualOperation, flowChartMerge,
    flowChartMultidocument, flowChartOfflineStorage, flowChartOffpageConnector, flowChartOnlineStorage,
    flowChartOr, flowChartPredefinedProcess, flowChartPreparation, flowChartProcess, flowChartPunchedCard,
    flowChartPunchedTape, flowChartSort, flowChartSummingJunction, flowChartTerminator, foldedCorner, frame,
    funnel, gear6, gear9, halfFrame, heart, heptagon, hexagon, homePlate, horizontalScroll, irregularSeal1,
    irregularSeal2, leftArrow, leftArrowCallout, leftBrace, leftBracket, leftCircularArrow, leftRightArrow,
    leftRightArrowCallout, leftRightCircularArrow, leftRightRibbon, leftRightUpArrow, leftUpArrow,
    lightningBolt, line, lineInv, mathDivide, mathEqual, mathMinus, mathMultiply, mathNotEqual, mathPlus,
    moon, nonIsoscelesTrapezoid, noSmoking, notchedRightArrow, octagon, parallelogram, pentagon, pie,
    pieWedge, plaque, plaqueTabs, plus, quadArrow, quadArrowCallout, rect, ribbon, ribbon2, rightArrow,
    rightArrowCallout, rightBrace, rightBracket, round1Rect, round2DiagRect, round2SameRect, roundRect,
    rtTriangle, smileyFace, snip1Rect, snip2DiagRect, snip2SameRect, snipRoundRect, squareTabs, star10,
    star12, star16, star24, star32, star4, star5, star6, star7, star8, straightConnector1, stripedRightArrow,
    sun, swooshArrow, teardrop, trapezoid, triangle, upArrow, upArrowCallout, upDownArrow, upDownArrowCallout,
    uturnArrow, verticalScroll, wave, wedgeEllipseCallout, wedgeRectCallout, wedgeRoundRectCallout
}

object shape {
    var shape_kind kind;
    var int x;
    var int y;
    var int width;
    var int height;
    var text text = "";
    var text_anchor anchor = middle;
}

/*
slide(없으면 layout)의 배경에서 자기 자리를 잘라 blur만큼 흐리게 한 조각. 모양은 shape처럼 kind로 정한다.
그 위에 반투명한 shape를 겹치면 뒤가 흐리게 비치는 유리가 된다. 흐려지는 것은 배경뿐이고 다른 도형은 흐려지지 않는다.
fill은 쓸 수 없다
*/
object backdrop {
    var shape_kind kind;
    var int x;
    var int y;
    var int width;
    var int height;
    var int blur;
}

/* 선 끝 모양. 선 종류는 모든 개체의 line_dash 속성이다 */
enum line_arrow { none, triangle, stealth, diamond, oval, arrow }

/* 두 점 (x1, y1), (x2, y2)을 잇는 선 */
object line {
    var int x1;
    var int y1;
    var int x2;
    var int y2;
    var line_arrow start_arrow = none;
    var line_arrow end_arrow = none;
}

/* 연결선 모양과 붙는 쪽. auto면 두 개체가 놓인 방향을 보고 마주 보는 쪽을 고른다 */
enum connector_kind { straight, elbow, curved }
enum connector_side { auto, top, right, bottom, left }

/* put ... as로 이름을 붙인 두 개체를 잇는 선. PowerPoint에서 개체를 옮기면 선이 따라간다 */
object connector {
    var ref from;
    var ref to;
    var connector_kind kind = straight;
    var connector_side from_side = auto;
    var connector_side to_side = auto;
    var line_arrow start_arrow = none;
    var line_arrow end_arrow = none;
}

/* SVG path 문법(M, L, H, V, C, S, Q, T, A, Z)으로 그리는 도형. 좌표는 (x, y)에서 잰 px이고 크기는 path에서 정해진다 */
object freeform {
    var int x;
    var int y;
    var string path;
}

/*
layout의 개체 틀(제목, 부제목, 본문). slide는 title, subtitle, body 속성으로 내용만 채운다.
text는 비어 있을 때 보이는 안내 글이고, 그 첫 글자의 모양이 slide 글자의 기본 모양이 된다
*/
object placeholder {
    var placeholder_role role;
    var int x;
    var int y;
    var int width;
    var int height;
    var text text = "";
    var text_anchor anchor = top;
}

/* 비디오와 오디오가 재생을 시작하는 때. click_sequence는 애니메이션 순서에 들어가 그 차례의 클릭에, auto는 앞 애니메이션이 끝나면 저절로,
   when_clicked는 그 개체를 눌렀을 때 재생한다 */
enum media_start { click_sequence, auto, when_clicked }

/* 비디오(mp4, webm). poster는 재생하기 전에 보이는 그림이고, 없으면 회색 판에 재생 단추를 그린다.
   trim_*은 앞뒤에서 잘라 낼 길이, fade_*는 소리가 커지고 작아지는 길이다 */
object video {
    var video data;
    var int x;
    var int y;
    var int width;
    var int height;
    var image poster = "";
    var media_start start = click_sequence;
    var bool fullscreen = false;
    var bool loop = false;
    var bool rewind = false;
    var bool hide_when_stopped = false;
    var float volume = 100%;
    var float trim_start = 0s;
    var float trim_end = 0s;
    var float fade_in = 0s;
    var float fade_out = 0s;
}

/* 오디오(mp3, wav, m4a). 슬라이드에는 스피커 아이콘으로 보인다. across_slides면 다음 슬라이드로 넘어가도 계속 재생한다 */
object audio {
    var audio data;
    var int x;
    var int y;
    var int width = 48;
    var int height = 48;
    var media_start start = click_sequence;
    var bool across_slides = false;
    var bool loop = false;
    var bool rewind = false;
    var bool hide_icon = false;
    var float volume = 100%;
    var float trim_start = 0s;
    var float trim_end = 0s;
    var float fade_in = 0s;
    var float fade_out = 0s;
}

/*
표. cells는 행마다 칸의 글을 늘어놓은 list<list<text>>이고, 모든 행의 칸 수가 같아야 한다.
width, height 안에서 열과 행은 col_widths, row_heights의 비율로 나뉜다(비우면 똑같이). 글이 길면 PowerPoint와 웹에서 행이 저절로 늘어난다.
header_rows, header_cols는 머리글로 쓰는 첫 행과 첫 열의 수다. 머리글 칸은 header_fill로 칠하고 글을 굵게 쓴다.
banded_rows, banded_cols는 본문의 첫 행, 첫 열부터 한 줄씩 건너 band_fill로 칠한다. fill은 나머지 칸의 바탕이다.
테두리는 line_color, line_width, line_dash로 정한다(안 쓰면 1px 회색 실선). padding은 칸 안쪽 여백, anchor는 칸 안에서 글의 세로 위치, align은 가로 위치다.
칸 하나만 다르게 하거나 병합하려면 put 안에 cell(행, 열) { col_span = 2; fill = ...; }을 쓴다. 행과 열 번호는 1부터다.
병합한 칸에 가려지는 칸은 ""로 비워 둔다
*/
object table {
    var list<list<text>> cells;
    var int x;
    var int y;
    var int width;
    var int height;
    var list<float> col_widths = [];
    var list<float> row_heights = [];
    var int header_rows = 0;
    var int header_cols = 0;
    var bool banded_rows = false;
    var bool banded_cols = false;
    var fill header_fill = hex(F2F2F2);
    var fill band_fill = hex(F7F7F7);
    var float padding = 8px;
    var text_anchor anchor = middle;
    var text_align align = left;
}

/*
수식. latex는 LaTeX 수식이다 (\는 \\로 적는다. 예: "\\frac{a}{b}"). html, pdf, png는 KaTeX로 그리고, pptx는 PowerPoint의 수식으로 바꿔 넣는다.
pptx에서 쓸 수 없는 명령은 pptx를 만드는 문서에서 오류다. 지원하는 것: 분수(\\frac, \\binom), 제곱근(\\sqrt), 첨자(^, _), \\left \\right 괄호,
\\sum \\prod \\int 같은 큰 연산자, \\lim, 함수 이름(\\sin 등), 그리스 문자와 기호(\\alpha \\times \\leq \\infty 등), 글자 모양(\\mathbf \\mathrm \\mathbb \\mathcal \\text),
위 부호(\\hat \\vec \\bar \\overline), 행렬(matrix, pmatrix, bmatrix, vmatrix, cases).
font_size는 수식의 글자 크기이고 align은 상자 안의 가로, anchor는 세로 위치다.
*/
object math {
    var string latex;
    var int x;
    var int y;
    var int width;
    var int height;
    var float font_size = 32px;
    var color text_color = hex(000000);
    var text_align align = center;
    var text_anchor anchor = middle;
}

/* 차트 종류. column은 세로 막대, bar는 가로 막대, area는 영역, scatter는 산점도다 */
enum chart_kind { column, bar, line, area, pie, scatter }

/* 범례의 자리. none이면 그리지 않는다 */
enum chart_legend { none, top, bottom, left, right }

/*
차트. 데이터는 이 안에 적고, 같은 차트를 html, pdf, png에서는 직접 그리고 pptx에서는 PowerPoint의 차트(데이터 편집 가능)로 만든다.
values는 계열(series)마다 한 줄이고, 줄마다 categories와 같은 수의 값을 적는다. categories를 비우면 1, 2, 3, ...이다. names는 계열의 이름이다(비우면 Series 1, ...).
원(pie)은 첫 계열만 그리고 categories가 조각의 이름이다. 산점도(scatter)는 categories 대신 xs에 계열마다 점의 x 값을, values에 y 값을 같은 수로 적는다.
stacked는 막대, 영역의 계열을 쌓는다. smooth와 markers는 선과 산점도에, data_labels는 값을 그림 위에 적는다.
colors는 계열(원은 조각)의 색이고 모자라면 처음부터 되풀이하며, 비우면 테마의 강조색 accent1 ~ accent6을 차례로 쓴다.
range는 값 축의 [최소, 최대]이고 비우면 자동이다. font_size와 text_color는 제목, 축, 범례의 글이다.
*/
object chart {
    var chart_kind kind;
    var list<list<float>> values;
    var list<string> categories = [];
    var list<string> names = [];
    var list<list<float>> xs = [];
    var int x;
    var int y;
    var int width;
    var int height;
    var string title = "";
    var string x_title = "";
    var string y_title = "";
    var chart_legend legend = bottom;
    var bool stacked = false;
    var bool data_labels = false;
    var bool smooth = false;
    var bool markers = true;
    var bool gridlines = true;
    var list<color> colors = [];
    var list<float> range = [];
    var float font_size = 14px;
    var color text_color = hex(404040);
}
